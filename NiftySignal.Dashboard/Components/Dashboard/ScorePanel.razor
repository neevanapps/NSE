@implements IAsyncDisposable
@using NiftySignal.Dashboard.Services
@using NiftySignal.Domain
@using NiftySignal.Domain.Enums
@inject LiveDataService Live
@inject IJSRuntime JS

<div class="panel score-panel">
    <div class="panel-title">
        Core Directional Score
        <span class="text-faint" style="font-weight:400; text-transform:none; letter-spacing:normal;">core-score-live-2026-09-13 (docs/replication_plan.md)</span>
    </div>

    <div class="score-top">
        <div class="score-readout">
            <div class="score-number @ScoreColorClass">@Live.CurrentCoreScore.ToString("+0;-0;0")</div>
            <div class="score-label badge @ScoreBadgeClass">@ScoreLabel</div>
            <div class="mono text-faint fast-slow-readout">fast @FormatFastSlow(Live.CurrentCoreScoreFast) / slow @FormatFastSlow(Live.CurrentCoreScoreSlow)</div>
        </div>
    </div>
    <div class="score-chart">
        <canvas id="core-score-history-chart"></canvas>
    </div>

    <div class="components">
        @foreach (var c in Live.CoreScoreComponents)
        {
            <div class="component-row">
                <span class="health-dot @(c.IsWarmedUp ? "ok" : "pending")" title="@(c.IsWarmedUp ? "Warmed up" : "Still building today's session rank")"></span>
                <span class="component-name text-dim">@FormatName(c.Name)</span>
                <div class="component-bar-track">
                    <div class="component-bar @((c.SignedValue ?? 0) >= 0 ? "bull" : "bear")" style="@BarStyle(c.SignedValue ?? 0)"></div>
                </div>
                <span class="mono text-faint component-weight">w=@c.Weight.ToString("0.00")</span>
                <span class="mono @((c.SignedValue ?? 0) >= 0 ? "text-bull" : "text-bear") component-z">@(c.SignedValue is { } v ? v.ToString("+0.00;-0.00") : "--")</span>
            </div>
        }
    </div>

    <div class="panel-title" style="margin-top:16px;">Strategy Positions</div>
    <div class="strategy-positions">
        @foreach (var sp in Live.StrategyPositions)
        {
            <div class="strategy-row">
                <span class="strategy-name text-dim">@StrategyLabel(sp.StrategyId)</span>
                @if (sp.Position is { } p)
                {
                    <span class="badge @(p.Direction == EntryDirection.Bullish ? "badge-bull" : "badge-bear")">@(p.Direction == EntryDirection.Bullish ? "CE" : "PE")</span>
                    <span class="mono strategy-symbol">@p.TradingSymbol</span>
                    <span class="mono text-faint">entry @p.EntryPremium.ToString("0.00")</span>
                    <span class="mono text-faint">ltp @p.CurrentPremium.ToString("0.00")</span>
                    <span class="mono @(p.UnrealizedPnl >= 0 ? "text-bull" : "text-bear")">@p.UnrealizedPnl.ToString("+0.00;-0.00")</span>
                    <span class="text-faint">@FormatHeld(p.EntryTime)</span>
                }
                else
                {
                    <span class="badge badge-neutral">FLAT</span>
                    <span class="text-faint strategy-symbol">@StrategySignalReading(sp.StrategyId)</span>
                }
            </div>
        }
    </div>

    <div class="panel-title" style="margin-top:16px;">Data Gaps (last 24h)</div>
    <div class="text-faint" style="font-size:13px;">No gaps recorded.</div>
</div>

@code {
    IJSObjectReference? _module;
    bool _rendered;

    string ScoreColorClass => Live.CurrentCoreScore switch
    {
        > 10 => "text-bull",
        < -10 => "text-bear",
        _ => "text-dim",
    };

    string ScoreBadgeClass => Live.CurrentCoreScore switch
    {
        > 10 => "badge-bull",
        < -10 => "badge-bear",
        _ => "badge-neutral",
    };

    string ScoreLabel => Live.CurrentCoreScore switch
    {
        > 55 => "Strongly Bullish",
        > 10 => "Bullish",
        < -55 => "Strongly Bearish",
        < -10 => "Bearish",
        _ => "Neutral",
    };

    static string FormatFastSlow(double? v) => v is { } value ? value.ToString("+0.0;-0.0") : "--";

    static string StrategyLabel(StrategyId id) => id switch
    {
        StrategyId.CoreScoreHysteresis => "Hysteresis",
        StrategyId.CoreScoreCrossover => "Crossover",
        _ => id.ToString(),
    };

    // Flat-state context reading, one per strategy since each reads a different part of the same
    // CoreScoreSnapshot: Hysteresis watches the instant score against its +-30 entry threshold;
    // Crossover watches fast-vs-slow, which the instant score alone doesn't show.
    string StrategySignalReading(StrategyId id) => id switch
    {
        StrategyId.CoreScoreHysteresis => $"score {Live.CurrentCoreScore.ToString("+0.0;-0.0")} (enters at |score| >= 30)",
        StrategyId.CoreScoreCrossover => $"fast {FormatFastSlow(Live.CurrentCoreScoreFast)} / slow {FormatFastSlow(Live.CurrentCoreScoreSlow)}",
        _ => "",
    };

    static string FormatName(string name) => name switch
    {
        "DepthImbalance" => "Depth Imbalance",
        "ItmSkew" => "ITM Skew",
        "FutureCvdNet5Min" => "Future CVD (5m net)",
        "NotionalVolumeRatio" => "Notional Volume Ratio",
        "GammaExposure" => "Gamma Exposure",
        "TrendReversion15m" => "Trend Reversion (15m)",
        "BasisChange" => "Basis Change",
        "OiChangeDiff15m" => "OI Change Diff (15m)",
        _ => name,
    };

    // Core-score components are already session-rank-normalized to [-1,1] (see
    // CoreScoreSnapshot's own doc comment), unlike the old composite's unbounded z-scores -- the
    // bar fills its full half-track at |v|=1 rather than needing the old /3 scaling.
    static string BarStyle(double v)
    {
        var pct = Math.Min(100, Math.Abs(v) * 100);
        var side = v >= 0 ? "left" : "right";
        return $"width:{pct.ToString("0")}%; {side}: 50%;";
    }

    static string FormatHeld(DateTimeOffset entryTime)
    {
        var held = DateTimeOffset.Now - entryTime;
        return held.TotalMinutes >= 60 ? $"{held.TotalHours:0.0}h" : $"{held.TotalMinutes:0}m";
    }

    protected override void OnInitialized() => Live.Updated += OnDemoUpdated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await RenderChart();
            _rendered = true;
        }
    }

    // Fast/slow ride the same time axis as the instant score (2026-09-15) -- exactly the two
    // trailing reads the Crossover strategy trades on, so their crossover is visible on the same
    // plot as the Hysteresis strategy's own +-30 threshold read. Spot rides alongside on its own
    // axis, joined here against CoreScoreSnapshot's cadence timestamps (see LiveDataService.
    // PollAsync's own join).
    (string[] Labels, double[] Scores, double?[] Fast, double?[] Slow, double?[] Prices) BuildSeries()
    {
        var history = Live.CoreScoreHistory;
        return (
            history.Select(h => h.Timestamp.ToIst().ToString("HH:mm:ss")).ToArray(),
            history.Select(h => Math.Round(h.Score, 1)).ToArray(),
            history.Select(h => h.Fast).ToArray(),
            history.Select(h => h.Slow).ToArray(),
            history.Select(h => h.SpotPrice).ToArray());
    }

    async Task RenderChart()
    {
        if (_module is null) return;
        var (labels, scores, fast, slow, prices) = BuildSeries();
        await _module.InvokeVoidAsync("renderCoreScoreChart", "core-score-history-chart", labels, scores, fast, slow, prices);
    }

    // async void is required here -- Live.Updated is a plain event Action?, and it fires for
    // every connected circuit (every open tab, desktop or mobile) on every 5s poll. If any one
    // of those circuits is mid-disconnect right at that instant (a tab closed, a phone locking,
    // a network blip), the JS interop call below throws -- and because this is async void, an
    // uncaught exception here has no Task to land on and crashes the whole Dashboard process
    // for every user, not just the disconnecting circuit (live-caught 2026-09-07, twice in one
    // morning). The three exception types below are Blazor Server's well-known signals for
    // exactly that "circuit is going away" case -- expected and harmless, not a real failure.
    async void OnDemoUpdated()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                StateHasChanged();
                if (_rendered && _module is not null)
                {
                    var (labels, scores, fast, slow, prices) = BuildSeries();
                    await _module.InvokeVoidAsync("updateCoreScoreChart", "core-score-history-chart", labels, scores, fast, slow, prices);
                }
            });
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // This circuit is going away -- nothing to update client-side.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.Updated -= OnDemoUpdated;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit is already gone (tab closed, navigation) -- nothing to clean up client-side.
            }
        }
    }
}
