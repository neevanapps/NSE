@implements IAsyncDisposable
@using NiftySignal.Dashboard.Services
@inject LiveDataService Live
@inject IJSRuntime JS

<div class="panel score-panel">
    <div class="panel-title">
        Universal Directional Score
        <span class="text-faint" style="font-weight:400; text-transform:none; letter-spacing:normal;">weights v1 (plan &sect;6)</span>
    </div>

    <div class="score-top">
        <div class="score-readout">
            <div class="score-number @ScoreColorClass">@Live.CurrentScore.ToString("+0;-0;0")</div>
            <div class="score-label badge @ScoreBadgeClass">@ScoreLabel</div>
        </div>
        <div class="score-chart">
            <canvas id="score-history-chart"></canvas>
        </div>
    </div>

    <div class="components">
        @foreach (var c in Live.ScoreComponents)
        {
            <div class="component-row">
                <span class="health-dot @(c.IsWarmedUp ? "ok" : "pending")" title="@(c.IsWarmedUp ? "Warmed up" : $"~{FormatWindow(c.Remaining)} left")"></span>
                <span class="component-name text-dim">@FormatName(c.Name)</span>
                <div class="component-bar-track">
                    <div class="component-bar @(c.ZScore >= 0 ? "bull" : "bear")" style="@BarStyle(c.ZScore)"></div>
                </div>
                <span class="mono text-faint component-weight">w=@c.Weight.ToString("0.00")</span>
                <span class="mono @(c.ZScore >= 0 ? "text-bull" : "text-bear") component-z">z=@c.ZScore.ToString("+0.00;-0.00")</span>
            </div>
        }
    </div>

    <div class="panel-title" style="margin-top:16px;">Data Gaps (last 24h)</div>
    <div class="text-faint" style="font-size:13px;">No gaps recorded.</div>
</div>

@code {
    IJSObjectReference? _module;
    bool _rendered;

    string ScoreColorClass => Live.CurrentScore switch
    {
        > 10 => "text-bull",
        < -10 => "text-bear",
        _ => "text-dim",
    };

    string ScoreBadgeClass => Live.CurrentScore switch
    {
        > 10 => "badge-bull",
        < -10 => "badge-bear",
        _ => "badge-neutral",
    };

    string ScoreLabel => Live.CurrentScore switch
    {
        > 55 => "Strongly Bullish",
        > 10 => "Bullish",
        < -55 => "Strongly Bearish",
        < -10 => "Bearish",
        _ => "Neutral",
    };

    static string FormatName(string name) => name switch
    {
        "OiBuildupNet" => "OI Buildup Net",
        "Pcr" => "Aggregate PCR",
        "FuturesBasis" => "Futures Basis",
        "IvSkew" => "IV Skew",
        "PriceMomentum" => "Price Momentum",
        "DepthImbalance" => "Depth Imbalance",
        "VixChange" => "VIX Change",
        _ => name,
    };

    static string BarStyle(double z)
    {
        var pct = Math.Min(100, Math.Abs(z) / 3 * 100);
        var side = z >= 0 ? "left" : "right";
        return $"width:{pct.ToString("0")}%; {side}: 50%;";
    }

    static string FormatWindow(TimeSpan t) => t.TotalMinutes >= 60
        ? $"{t.TotalHours:0.#}h"
        : $"{t.TotalMinutes:0}m";

    protected override void OnInitialized() => Live.Updated += OnDemoUpdated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await RenderChart();
            _rendered = true;
        }
    }

    // Spot rides on the same time axis as the score so the two can be read against each other
    // -- "did the score turn before price did?" is the whole question this panel exists to
    // answer. Nulls (snapshots predating the SpotPrice column) pass through as gaps rather
    // than being coerced to zero, which would drag the price axis to the floor.
    (string[] Labels, double[] Scores, double?[] Prices) BuildSeries()
    {
        var history = Live.ScoreHistory;
        return (
            history.Select(h => h.Timestamp.ToString("HH:mm:ss")).ToArray(),
            history.Select(h => Math.Round(h.Score, 1)).ToArray(),
            history.Select(h => h.SpotPrice).ToArray());
    }

    async Task RenderChart()
    {
        if (_module is null) return;
        var (labels, scores, prices) = BuildSeries();
        await _module.InvokeVoidAsync("renderScoreWithPriceChart", "score-history-chart", labels, scores, prices, "#38bdf8", "#fbbf24");
    }

    // async void is required here -- Live.Updated is a plain event Action?, and it fires for
    // every connected circuit (every open tab, desktop or mobile) on every 5s poll. If any one
    // of those circuits is mid-disconnect right at that instant (a tab closed, a phone locking,
    // a network blip), the JS interop call below throws -- and because this is async void, an
    // uncaught exception here has no Task to land on and crashes the whole Dashboard process
    // for every user, not just the disconnecting circuit (live-caught 2026-09-07, twice in one
    // morning). The three exception types below are Blazor Server's well-known signals for
    // exactly that "circuit is going away" case -- expected and harmless, not a real failure.
    async void OnDemoUpdated()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                StateHasChanged();
                if (_rendered && _module is not null)
                {
                    var (labels, scores, prices) = BuildSeries();
                    await _module.InvokeVoidAsync("updateScoreWithPriceChart", "score-history-chart", labels, scores, prices);
                }
            });
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // This circuit is going away -- nothing to update client-side.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.Updated -= OnDemoUpdated;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit is already gone (tab closed, navigation) -- nothing to clean up client-side.
            }
        }
    }
}
