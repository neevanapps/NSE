@implements IAsyncDisposable
@using NiftySignal.Dashboard.Services
@using NiftySignal.Domain
@using NiftySignal.Domain.Enums
@using NiftySignal.Rules
@inject LiveDataService Live
@inject IJSRuntime JS

<div class="panel performance-panel">
    <div class="panel-title">Performance (paper trades, last 24h)</div>

    <div class="stat-row">
        <div class="stat">
            <span class="stat-value @(WinRate >= 50 ? "text-bull" : "text-dim")">@WinRate.ToString("0")%</span>
            <span class="stat-label">Win rate</span>
        </div>
        <div class="stat">
            <span class="stat-value @(TotalPnl >= 0 ? "text-bull" : "text-bear")">@TotalPnl.ToString("+0;-0")</span>
            <span class="stat-label">Net P&amp;L</span>
        </div>
        <div class="stat">
            <span class="stat-value text-dim">@ProfitFactor.ToString("0.00")</span>
            <span class="stat-label">Profit factor</span>
        </div>
        <div class="stat">
            <span class="stat-value text-bull">+@AvgWin.ToString("0")</span>
            <span class="stat-label">Avg win</span>
        </div>
        <div class="stat">
            <span class="stat-value text-bear">@AvgLoss.ToString("0")</span>
            <span class="stat-label">Avg loss</span>
        </div>
        <div class="stat">
            <span class="stat-value text-dim">@Live.ClosedTrades.Count</span>
            <span class="stat-label">Trades</span>
        </div>
    </div>

    <div class="equity-chart">
        <canvas id="equity-curve-chart"></canvas>
    </div>

    <div class="scroll-x">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Symbol</th>
                    <th>Dir</th>
                    <th>Entry</th>
                    <th>Exit</th>
                    <th>Reason</th>
                    <th>Net P&amp;L</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Live.ClosedTrades.OrderByDescending(t => t.ExitTime).Take(10))
                {
                    <tr>
                        <td>@t.TradingSymbol</td>
                        <td><span class="badge @(t.Direction == EntryDirection.Bullish ? "badge-bull" : "badge-bear")">@(t.Direction == EntryDirection.Bullish ? "CE" : "PE")</span></td>
                        <td class="text-faint">@t.EntryTime.ToIst().ToString("HH:mm")</td>
                        <td class="text-faint">@t.ExitTime.ToIst().ToString("HH:mm")</td>
                        <td class="text-dim">@t.ExitReason</td>
                        <td class="@(t.NetPnl >= 0 ? "text-bull" : "text-bear")">@t.NetPnl.ToString("+0.00;-0.00")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    IJSObjectReference? _module;
    bool _rendered;
    int _renderedTradeCount = -1;

    double WinRate => Live.ClosedTrades.Count == 0 ? 0 : 100.0 * Live.ClosedTrades.Count(t => t.NetPnl > 0) / Live.ClosedTrades.Count;
    decimal TotalPnl => Live.ClosedTrades.Sum(t => t.NetPnl);
    decimal AvgWin => AvgOf(t => t.NetPnl > 0);
    decimal AvgLoss => AvgOf(t => t.NetPnl < 0);

    double ProfitFactor
    {
        get
        {
            var grossWin = Live.ClosedTrades.Where(t => t.NetPnl > 0).Sum(t => t.NetPnl);
            var grossLoss = Math.Abs(Live.ClosedTrades.Where(t => t.NetPnl < 0).Sum(t => t.NetPnl));
            return grossLoss == 0 ? 0 : (double)(grossWin / grossLoss);
        }
    }

    decimal AvgOf(Func<ClosedTradeRow, bool> predicate)
    {
        var trades = Live.ClosedTrades.Where(predicate).ToList();
        return trades.Count == 0 ? 0 : trades.Average(t => t.NetPnl);
    }

    (string[] Labels, double[] Equity) BuildEquitySeries()
    {
        var ordered = Live.ClosedTrades.OrderBy(t => t.ExitTime).ToList();
        var labels = ordered.Select(t => t.ExitTime.ToIst().ToString("HH:mm")).ToArray();
        decimal running = 0;
        var equity = ordered.Select(t => (double)(running += t.NetPnl)).ToArray();
        return (labels, equity);
    }

    protected override void OnInitialized() => Live.Updated += OnDemoUpdated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            var (labels, equity) = BuildEquitySeries();
            await _module.InvokeVoidAsync("renderLineChart", "equity-curve-chart", labels, equity, "#a78bfa");
            _renderedTradeCount = Live.ClosedTrades.Count;
            _rendered = true;
        }
    }

    // Audit finding (2026-09-08 dashboard fix): this panel never subscribed to Live.Updated at
    // all, so neither the win-rate/P&L stats nor the trades table ever refreshed after a trade
    // closed -- only a full page reload picked up new data. Wired the same way ScorePanel
    // already handles its own live-updating chart: StateHasChanged for the stat/table markup,
    // plus an in-place chart update (not a full renderLineChart -- see charts.js's own "avoids
    // flicker" comment) whenever the closed-trade count actually changed. async void + the
    // three-exception catch matches ScorePanel's own reasoning: Live.Updated fires for every
    // connected circuit, and a circuit mid-disconnect at that instant must not crash the others.
    async void OnDemoUpdated()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                StateHasChanged();
                if (_rendered && _module is not null && Live.ClosedTrades.Count != _renderedTradeCount)
                {
                    _renderedTradeCount = Live.ClosedTrades.Count;
                    var (labels, equity) = BuildEquitySeries();
                    await _module.InvokeVoidAsync("updateLineChart", "equity-curve-chart", labels, equity);
                }
            });
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // This circuit is going away -- nothing to update client-side.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.Updated -= OnDemoUpdated;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit is already gone (tab closed, navigation) -- nothing to clean up client-side.
            }
        }
    }
}
