@using NiftySignal.Dashboard.Services
@using NiftySignal.MarketSummary
@using SummaryMetric = NiftySignal.MarketSummary.Metric

@* Primary Market Summary: the Futures Summary and the one compact TOTAL summary (all ten ATM±2 contracts), five rows each (5 / 10 / 50 / 100 Bars / Day), completed bars only, one fixed basket for every window.
   The ATM / ITM / OTM summaries are no longer presented (2026-11-02); their aggregation stays in MarketSummaryView / NiftySignal.MarketSummary untouched.
   Pure presentation of MarketSummaryView; all arithmetic is in NiftySignal.MarketSummary (docs/MARKET_SUMMARY_METRICS.md). Unavailable values render as —, never as zero.
   MicroDev is displayed inverted (MicroDevDisplay), exactly once, here at render time. *@
<section class="adaptive-grid-section market-summary" data-testid="market-summary">
    <h3>MARKET SUMMARY <span class="text-faint">completed bars only · windows end at the same completed bar · Direction = CE − PE, OI = PE − CE · Delta ×100 / Vega ×100 are display scaling only · @MicroDevDisplay.Legend</span></h3>
    @if (View is null || View.UnavailableReason is not null)
    {
        <div class="adaptive-pending" data-testid="market-summary-unavailable">Market summary unavailable: @(View?.UnavailableReason ?? "not loaded").</div>
    }
    else
    {
        var basket = View.Basket!;
        <div class="adaptive-note" data-testid="market-summary-basket">
            Basket (fixed for all windows): expiry @basket.Expiry.ToString("dd-MMM-yyyy") · centre @basket.Center.ToString("0") · step @(basket.Step?.ToString("0.##") ?? "—") · through completed bar @View.EndBarSeq.
            @if (basket.Problems.Count > 0)
            {
                <span class="adaptive-alert" data-testid="market-summary-problems">@string.Join("; ", basket.Problems)</span>
            }
        </div>

        @if (View.CloseAtmStrike is { } closeAtm)
        {
            <div class="adaptive-subtitle" data-testid="summary-close-atm">ATM at bar close <span data-testid="summary-close-atm-strike">@closeAtm.ToString("0.##")</span> <span class="text-faint">@CloseAtmSourceText(View.CloseAtmSource)</span></div>
        }

        @if (View.DepthNote is { } depthNote)
        {
            <div class="adaptive-note" data-testid="market-summary-depth-note">@depthNote</div>
        }

        @if (View.Unverified.Count > 0)
        {
            <div class="adaptive-alert" data-testid="market-summary-unverified" title="Stored per-strike rows disagreed with the values reconstructed after a restart; they are withheld, so the affected windows show reduced coverage.">UNVERIFIED per-strike data withheld (not shown as observations): @string.Join(", ", View.Unverified.Take(12))@(View.Unverified.Count > 12 ? $" … +{View.Unverified.Count - 12} more" : "")</div>
        }

        <div class="adaptive-subtitle" data-testid="summary-futures-title">FUTURES SUMMARY</div>
        <div class="adaptive-table-wrap">
            <table class="adaptive-table adaptive-table-compact" data-grid="summary-futures">
                <thead>
                <tr>
                    <th>Window</th><th>Coverage</th><th>Price Δ</th><th>Volume</th>
                    <th title="raw Strict delta (Strict delta / volume, %)">Strict Δ</th><th title="raw Enriched delta (/ classified volume, %)">Enriched Δ</th>
                    <th title="usable-seconds weighted MicroDev (TOB x 100), displayed inverted: displayed = −raw">@MicroDevDisplay.Label</th><th title="net OFI (net / gross, %)">OFI</th><th>OI Δ</th><th>Activity /s</th>
                    <th title="Top-5 Notional Depth Imbalance L5 (EVENT-BASED) = (ΣBid − ΣAsk) / (ΣBid + ΣAsk) of the window's accumulated notionals: every distinct coherent five-level snapshot counts once, no time weighting (shown as fraction (ratio %)). Unavailable when the Top-5 sidecar is off or no bar had an eligible depth event. Sign is a hypothesis.">Depth Imb L5</th>
                    <th title="Top-5 OFI5 = ΣNet / ΣGross of the window (price-aligned transitions, D10 conditional bridging); raw (ratio %). Sign is a hypothesis.">OFI5</th><th title="Top-5 MicroDev5Proxy (EVENT-BASED) = ΣMicroDev5 / ΣEvents; ratio = mean TOB5 × 100; displayed inverted like the Level-1 MicroDev: displayed = −raw. Sign is a hypothesis.">MicroDev5 (Inv)</th>
                    <th title="India VIX level at the window end (latest valid observation at or before the boundary, within the freshness limit)">VIX</th><th title="VIX change over the window (end − start)">VIX Δ</th><th title="VIX change / start VIX × 100">VIX Δ%</th><th title="age of the end observation at the boundary">VIX age</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in View.Futures)
                {
                    var micro = MicroDevDisplay.Invert(r.MicroDev);
                    <tr data-window="@r.Window.Name">
                        <td class="sticky-col">@r.Window.Name</td>
                        <td title="@CoverageTitle(r.Coverage)" data-coverage="@r.Coverage.Status">@r.Coverage.Text</td>
                        @if (r.Coverage.Status == CoverageStatus.Insufficient)
                        {
                            @for (var i = 0; i < 8; i++) { <td>—</td> }
                        }
                        else
                        {
                            <td class="@Sc(r.Price)" data-sign="@RatioFormat.SignName(r.Price.Raw)">@Cell(r.Price, 2)</td><td>@r.Volume.ToString("N0")</td><td class="@Sc(r.Strict)" data-sign="@RatioFormat.SignName(r.Strict.Raw)">@Cell(r.Strict)</td><td class="@Sc(r.Enriched)" data-sign="@RatioFormat.SignName(r.Enriched.Raw)">@Cell(r.Enriched)</td><td class="@Sc(micro)" data-sign="@RatioFormat.SignName(micro.Raw)">@Cell(micro, 2)</td><td class="@Sc(r.Ofi)" data-sign="@RatioFormat.SignName(r.Ofi.Raw)">@Cell(r.Ofi)</td><td>@Cell(r.Oi)</td>
                            <td>@RatioFormat.Plain(r.Activity, 1)</td>
                        }
                        @DepthCell(View.FuturesDepth?.FirstOrDefault(x => x.Window.Name == r.Window.Name))
                        @Top5FuturesCells(View.FuturesDepth?.FirstOrDefault(x => x.Window.Name == r.Window.Name))
                        @VixCells(View, r.Window.Name)
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (View.Grids.FirstOrDefault(x => x.Kind == GridKind.Total) is { } total)
        {
            <div class="total-grids" data-testid="summary-total-grids">
                @* exactly three top option summaries, always in this order: ITM-shifted (close ATM - 1 step), ATM, OTM-shifted (close ATM + 1 step); CE and PE share each basket's strikes *@
                @if (View.Lower is { } itm && View.LowerBasket is { } itmBasket)
                {
                    <div class="total-grid-cell">@TotalGrid(itm, itmBasket, "TOTAL SUMMARY - ITM-SHIFTED (ATM-1 step)", "summary-total-itm", "summary-total-itm-title", View.LowerDepth)</div>
                }
                <div class="total-grid-cell">@TotalGrid(total, basket, "TOTAL SUMMARY - ATM", "summary-total", "summary-total-title", View.TotalDepth)</div>
                @if (View.Upper is { } otm && View.UpperBasket is { } otmBasket)
                {
                    <div class="total-grid-cell">@TotalGrid(otm, otmBasket, "TOTAL SUMMARY - OTM-SHIFTED (ATM+1 step)", "summary-total-otm", "summary-total-otm-title", View.UpperDepth)</div>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter] public MarketSummaryView? View { get; set; }

    RenderFragment TotalGrid(GridSummary grid, Basket basket, string title, string gridId, string testId, IReadOnlyList<DepthDirectionWindow>? depth) => @<text>
    <div class="adaptive-subtitle" data-testid="@testId">@title <span class="text-faint">@Describe(grid, basket)</span></div>
    <div class="adaptive-table-wrap">
        <table class="adaptive-table adaptive-table-compact" data-grid="@gridId">
            <thead>
            <tr>
                <th>Window</th><th>Coverage</th>
                <th>Price Dir</th><th>Roll Dir</th><th>Strict Dir</th><th>Enriched Dir</th>
                <th title="PE − CE">OI Dir</th><th title="raw CE − PE of the raw MicroDev values (NOT inverted; owner correction 2026-11-25)">MicroDev Dir</th><th>OFI Dir</th>
                <th title="displayed inverted: displayed = −raw (CE − PE)">@DirectionDisplay.IvLabel</th><th title="CE − PE (raw); ×100 display scaling">@DirectionDisplay.DeltaLabel</th><th title="displayed inverted: displayed = −raw (CE − PE); ×100 display scaling">@DirectionDisplay.VegaLabel</th><th>Activity Dir</th>
                <th title="Notional Depth L5 Direction (EVENT-BASED) = CE ratio − PE ratio. CE and PE are each normalized by their OWN pooled event notionals ΣBid + ΣAsk (every distinct coherent snapshot counts once, no time weighting) over contracts whose every bar of the window has an attested row with at least one eligible event; the count and event total are shown. Sign is a hypothesis.">Depth L5 Dir</th>
                <th title="OFI5 Dir = (ΣCE net − ΣPE net) / (ΣCE gross + ΣPE gross) over contracts with an attested depth row in every bar (combined-denominator rule, as OFI Dir). Sign is a hypothesis.">OFI5 Dir</th>
                <th title="MicroDev5 Dir = CE raw − PE raw of the EVENT-BASED MicroDev5Proxy (ΣMicroDev5 / ΣEvents per side), NOT inverted; ratio = (CE mean TOB5 − PE mean TOB5) / 2 × 100. Sign is a hypothesis.">MicroDev5 Dir</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in grid.Rows)
            {
                <tr data-window="@r.Window.Name">
                    <td class="sticky-col">@r.Window.Name</td>
                    <td title="@CoverageTitle(r.Coverage)" data-coverage="@r.Coverage.Status">@r.Coverage.Text@Deficits(r.Coverage, TotalFamilies)</td>
                    @if (r.Direction is null)
                    {
                        @for (var i = 0; i < 11; i++) { <td>—</td> }
                    }
                    else
                    {
                        var d = r.Direction;
                        @Dir(d.Price, 2)
                        @Dir(d.Roll, 2)
                        @Dir(d.Strict, 0)
                        @Dir(d.Enriched, 0)
                        @Dir(d.Oi, 0)
                        @Dir(d.MicroDev, 2)
                        @Dir(d.Ofi, 0)
                        @Dir(DirectionDisplay.Invert(d.Iv), 2)
                        @Dir(d.Delta, 2, scale100: true)
                        @Dir(DirectionDisplay.Invert(d.Vega), 2, scale100: true)
                        @Dir(d.Activity, 1)
                    }
                    @DepthDirCell(depth?.FirstOrDefault(x => x.Window.Name == r.Window.Name))
                    @Top5DirCells(depth?.FirstOrDefault(x => x.Window.Name == r.Window.Name))
                </tr>
            }
            </tbody>
        </table>
    </div>

    </text>;


    /// <summary>Futures Depth Imbalance L5 cell: fraction (ratio %); "—" with the reason when unavailable.</summary>
    static RenderFragment DepthCell(FuturesDepthWindow? w) => builder =>
    {
        builder.OpenElement(0, "td");
        builder.AddAttribute(1, "data-col", "depth-imb-l5");
        if (w is null || w.Imbalance.Raw is null)
        {
            builder.AddAttribute(2, "title", "unavailable: no usable Top-5 depth in this window (sidecar off, not recorded, or withheld)");
            builder.AddContent(3, "—");
        }
        else
        {
            var cls = RatioFormat.SignedClass(w.Imbalance.Raw);
            if (cls.Length > 0) builder.AddAttribute(2, "class", cls);
            builder.AddAttribute(4, "data-sign", RatioFormat.SignName(w.Imbalance.Raw));
            builder.AddAttribute(5, "title", $"bars with usable depth {w.Text}");
            builder.AddContent(6, RatioFormat.Cell(new RatioPart(w.Imbalance.Raw, w.Imbalance.Num, w.Imbalance.Den), 3) + (w.Status == CoverageStatus.Partial ? " · " + w.Text : ""));
        }

        builder.CloseElement();
    };

    /// <summary>Total-grid Depth L5 Direction cell: Direction (CE − PE ratio) with the CE / PE contract counts; unavailable unless BOTH sides have at least one included contract.</summary>
    static RenderFragment DepthDirCell(DepthDirectionWindow? w) => builder =>
    {
        builder.OpenElement(0, "td");
        builder.AddAttribute(1, "data-col", "depth-l5-dir");
        if (w is null || w.Direction.Raw is null)
        {
            builder.AddAttribute(2, "title", w is null ? "unavailable" : $"unavailable: needs, on BOTH sides, contracts whose every bar of the window has an attested row with an eligible depth event (CE {w.CeContracts}, PE {w.PeContracts} contracts; excluded - {w.DepthWhy ?? DepthExclusions.None})");
            builder.AddContent(3, "—");
        }
        else
        {
            var cls = RatioFormat.SignedClass(w.Direction.Raw);
            if (cls.Length > 0) builder.AddAttribute(2, "class", cls);
            builder.AddAttribute(4, "data-sign", RatioFormat.SignName(w.Direction.Raw));
            builder.AddAttribute(5, "title", $"CE {RatioFormat.Cell(new RatioPart(w.Ce.Raw, w.Ce.Num, w.Ce.Den), 3)} ({w.CeContracts} contracts) − PE {RatioFormat.Cell(new RatioPart(w.Pe.Raw, w.Pe.Num, w.Pe.Den), 3)} ({w.PeContracts} contracts)");
            builder.AddContent(6, RatioFormat.Cell(new RatioPart(w.Direction.Raw, w.Direction.Num, w.Direction.Den), 3) + $" · {w.Included}/{w.Expected}");
        }

        builder.CloseElement();
    };

    /// <summary>Futures OFI5 and MicroDev5 cells of one window (MicroDev5 displayed inverted exactly once, like the Level-1 MicroDev).</summary>
    static RenderFragment Top5FuturesCells(FuturesDepthWindow? w) => builder =>
    {
        void Td(int seq, string col, RatioPart part, int decimals, string title)
        {
            builder.OpenElement(seq, "td");
            builder.AddAttribute(seq + 1, "data-col", col);
            var cls = RatioFormat.SignedClass(part.Raw);
            if (cls.Length > 0) builder.AddAttribute(seq + 2, "class", cls);
            builder.AddAttribute(seq + 3, "data-sign", RatioFormat.SignName(part.Raw));
            builder.AddAttribute(seq + 4, "title", title);
            builder.AddContent(seq + 5, RatioFormat.Cell(part, decimals));
            builder.CloseElement();
        }

        var ofi = w?.Ofi5 ?? default;
        var micro = MicroDevDisplay.Invert(w?.MicroDev5 ?? default);
        Td(0, "ofi5", new RatioPart(ofi.Raw, ofi.Num, ofi.Den), 0, ofi.Raw is null ? "unavailable: no bar of the window had a valid Top-5 transition" : "ΣNet / ΣGross OFI5 of the window");
        Td(10, "microdev5", new RatioPart(micro.Raw, micro.Num, micro.Den), 2, micro.Raw is null ? "unavailable: no bar of the window had an eligible depth event" : $"event-based MicroDev5Proxy, {w!.MicroDev5Events} eligible events; displayed = −raw");
    };

    /// <summary>OFI5 Dir and MicroDev5 Dir (RAW, not inverted) cells of a Total grid window, each with its own eligible-contract count.</summary>
    static RenderFragment Top5DirCells(DepthDirectionWindow? w) => builder =>
    {
        void Td(int seq, string col, SummaryMetric m, int decimals, string text, string unavailable)
        {
            builder.OpenElement(seq, "td");
            builder.AddAttribute(seq + 1, "data-col", col);
            if (m.Raw is null)
            {
                builder.AddAttribute(seq + 2, "title", unavailable);
                builder.AddContent(seq + 5, "—");
            }
            else
            {
                var cls = RatioFormat.SignedClass(m.Raw);
                if (cls.Length > 0) builder.AddAttribute(seq + 2, "class", cls);
                builder.AddAttribute(seq + 3, "data-sign", RatioFormat.SignName(m.Raw));
                builder.AddAttribute(seq + 4, "title", $"contracts {text}");
                builder.AddContent(seq + 5, RatioFormat.Cell(new RatioPart(m.Raw, m.Num, m.Den), decimals) + $" · {text}");
            }

            builder.CloseElement();
        }

        Td(0, "ofi5-dir", w?.Ofi5Dir ?? default, 0, w?.Ofi5Text ?? "—", "unavailable: needs contracts with an attested depth row in every bar on BOTH sides");
        Td(10, "microdev5-dir", w?.MicroDev5Dir ?? default, 2, w?.MicroDev5Text ?? "—", "unavailable: needs contracts whose every bar has an eligible MicroDev5 event on BOTH sides");
    };

    static string CloseAtmSourceText(string? source) => source switch
    {
        "stored" => "(recorded at the bar's close)",
        "next-bar-start" => "(older bar: taken from the next bar's band, selected at this bar's close instant)",
        _ => "",
    };

    static string Sc(SummaryMetric m) => RatioFormat.SignedClass(m.Raw);

    static string Cell(SummaryMetric m, int rawDecimals = 0) => RatioFormat.Cell(new RatioPart(m.Raw, m.Num, m.Den), rawDecimals);

    RenderFragment VixCells(MarketSummaryView v, string window) => builder =>
    {
        var seq = 0;
        void Td(string text, string? title = null)
        {
            builder.OpenElement(seq++, "td");
            if (title is not null) builder.AddAttribute(seq++, "title", title);
            builder.AddContent(seq++, text);
            builder.CloseElement();
        }

        var w = v.Vix?.FirstOrDefault(x => x.Window.Name == window);
        if (w is null) { var why = v.VixUnavailableReason ?? "not loaded"; Td("—", "VIX unavailable: " + why); Td("—"); Td("—"); Td("—"); return; }
        string Pt(VixPoint p, string fmt) => p.Value is { } x ? x.ToString(fmt, System.Globalization.CultureInfo.InvariantCulture) : p.Status == VixStatus.Stale ? "stale" : "—";
        Td(Pt(w.End, "0.00"), w.End.Status == VixStatus.Stale ? $"last observation {w.End.AgeSeconds:0}s old at the boundary (limit {VixSummaryCalculator.FreshnessLimit.TotalSeconds:0}s)" : null);
        Td(w.Change is { } c ? c.ToString("+0.00;-0.00;0.00", System.Globalization.CultureInfo.InvariantCulture) : "—", w.Change is null ? "needs a fresh VIX at both the window start and end" : null);
        Td(w.ChangePct is { } p ? p.ToString("+0.00;-0.00;0.00", System.Globalization.CultureInfo.InvariantCulture) : "—");
        Td(w.End.AgeSeconds is { } a ? $"{a:0}s" : "—");
    };

    static readonly string[] TotalFamilies = ["Price", "Roll", "Strict", "Enriched", "Oi", "MicroDev", "Ofi", "Iv", "Delta", "Vega", "Activity"];

    /// <summary>Visible per-family coverage, only where a metric family has fewer usable contracts than the grid expects (e.g. " · OFI 0/10 · Delta 0/10"). Nothing is shown when every family is complete.</summary>
    static string Deficits(Coverage c, string[] families)
    {
        if (c.Status == CoverageStatus.Insufficient || c.Families is null) return "";
        var parts = families.Where(f => c.FamilyCount(f) < c.Expected).Select(f => $"{f} {c.FamilyCount(f)}/{c.Expected}").ToList();
        return parts.Count == 0 ? "" : " · " + string.Join(" · ", parts);
    }

    static string CoverageTitle(Coverage c) =>
        c.Status == CoverageStatus.Full ? "all expected contracts have every bar of the window"
        : $"{(string.IsNullOrEmpty(c.Reason) ? "" : c.Reason + "; ")}missing/partial: {(c.MissingTokens.Count == 0 ? "none listed" : string.Join(", ", c.MissingTokens))}";

    static string Describe(GridSummary g, Basket b) =>
        $"{g.Expected} contracts: " + string.Join(", ", b.For(g.Kind).Select(c => c.Token is null ? $"{(c.IsCall ? "CE" : "PE")} offset {c.Offset:+0;-0;0} (unresolved)" : $"{(c.IsCall ? "CE" : "PE")} {c.Strike:0}"));

    /// <summary>One Direction cell: signed tint on the sign of the defined Direction metric (sign only, no threshold); zero, missing and non-finite stay neutral. ×100 is display scaling and never changes the sign.</summary>
    static RenderFragment Dir(SummaryMetric m, int decimals, bool scale100 = false) => builder =>
    {
        var shown = new RatioPart(scale100 ? DisplayScale.Times100(m.Raw) : m.Raw, m.Num, m.Den);
        builder.OpenElement(0, "td");
        var cls = RatioFormat.SignedClass(shown.Raw);
        if (cls.Length > 0) builder.AddAttribute(1, "class", cls);
        builder.AddAttribute(2, "data-sign", RatioFormat.SignName(shown.Raw));
        builder.AddContent(3, RatioFormat.Cell(shown, decimals));
        builder.CloseElement();
    };
}
