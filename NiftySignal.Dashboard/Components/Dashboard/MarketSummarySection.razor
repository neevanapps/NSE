@using NiftySignal.Dashboard.Services
@using NiftySignal.MarketSummary
@using SummaryMetric = NiftySignal.MarketSummary.Metric

@* Primary Market Summary: the Futures Summary and the one compact TOTAL summary (all ten ATM±2 contracts), five rows each (5 / 10 / 50 / 100 Bars / Day), completed bars only, one fixed basket for every window.
   The ATM / ITM / OTM summaries are no longer presented (2026-11-02); their aggregation stays in MarketSummaryView / NiftySignal.MarketSummary untouched.
   Pure presentation of MarketSummaryView; all arithmetic is in NiftySignal.MarketSummary (docs/MARKET_SUMMARY_METRICS.md). Unavailable values render as —, never as zero.
   MicroDev is displayed inverted (MicroDevDisplay), exactly once, here at render time. *@
<section class="adaptive-grid-section market-summary" data-testid="market-summary">
    <h3>MARKET SUMMARY <span class="text-faint">completed bars only · windows end at the same completed bar · Direction = CE − PE, OI = PE − CE · Delta ×100 / Vega ×100 are display scaling only · @MicroDevDisplay.Legend</span></h3>
    @if (View is null || View.UnavailableReason is not null)
    {
        <div class="adaptive-pending" data-testid="market-summary-unavailable">Market summary unavailable: @(View?.UnavailableReason ?? "not loaded").</div>
    }
    else
    {
        var basket = View.Basket!;
        <div class="adaptive-note" data-testid="market-summary-basket">
            Basket (fixed for all windows): expiry @basket.Expiry.ToString("dd-MMM-yyyy") · centre @basket.Center.ToString("0") · step @(basket.Step?.ToString("0.##") ?? "—") · through completed bar @View.EndBarSeq.
            @if (basket.Problems.Count > 0)
            {
                <span class="adaptive-alert" data-testid="market-summary-problems">@string.Join("; ", basket.Problems)</span>
            }
        </div>

        <div class="adaptive-subtitle" data-testid="summary-futures-title">FUTURES SUMMARY</div>
        <div class="adaptive-table-wrap">
            <table class="adaptive-table adaptive-table-compact" data-grid="summary-futures">
                <thead>
                <tr>
                    <th>Window</th><th>Coverage</th><th>Price Δ</th><th>Volume</th>
                    <th title="raw Strict delta (Strict delta / volume, %)">Strict Δ</th><th title="raw Enriched delta (/ classified volume, %)">Enriched Δ</th>
                    <th title="usable-seconds weighted MicroDev (TOB x 100), displayed inverted: displayed = −raw">@MicroDevDisplay.Label</th><th title="net OFI (net / gross, %)">OFI</th><th>OI Δ</th><th>Activity /s</th>
                    <th title="India VIX level at the window end (latest valid observation at or before the boundary, within the freshness limit)">VIX</th><th title="VIX change over the window (end − start)">VIX Δ</th><th title="VIX change / start VIX × 100">VIX Δ%</th><th title="age of the end observation at the boundary">VIX age</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in View.Futures)
                {
                    var micro = MicroDevDisplay.Invert(r.MicroDev);
                    <tr data-window="@r.Window.Name">
                        <td class="sticky-col">@r.Window.Name</td>
                        <td title="@CoverageTitle(r.Coverage)" data-coverage="@r.Coverage.Status">@r.Coverage.Text</td>
                        @if (r.Coverage.Status == CoverageStatus.Insufficient)
                        {
                            @for (var i = 0; i < 8; i++) { <td>—</td> }
                        }
                        else
                        {
                            <td class="@Sc(r.Price)" data-sign="@RatioFormat.SignName(r.Price.Raw)">@Cell(r.Price, 2)</td><td>@r.Volume.ToString("N0")</td><td class="@Sc(r.Strict)" data-sign="@RatioFormat.SignName(r.Strict.Raw)">@Cell(r.Strict)</td><td class="@Sc(r.Enriched)" data-sign="@RatioFormat.SignName(r.Enriched.Raw)">@Cell(r.Enriched)</td><td class="@Sc(micro)" data-sign="@RatioFormat.SignName(micro.Raw)">@Cell(micro, 2)</td><td class="@Sc(r.Ofi)" data-sign="@RatioFormat.SignName(r.Ofi.Raw)">@Cell(r.Ofi)</td><td>@Cell(r.Oi)</td>
                            <td>@RatioFormat.Plain(r.Activity, 1)</td>
                        }
                        @VixCells(View, r.Window.Name)
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (View.Grids.FirstOrDefault(x => x.Kind == GridKind.Total) is { } total)
        {
            <div class="adaptive-subtitle" data-testid="summary-total-title">TOTAL SUMMARY <span class="text-faint">@Describe(total, basket)</span></div>
            <div class="adaptive-table-wrap">
                <table class="adaptive-table adaptive-table-compact" data-grid="summary-total">
                    <thead>
                    <tr>
                        <th>Window</th><th>Coverage</th>
                        <th>Price Dir</th><th>Roll Dir</th><th>Strict Dir</th><th>Enriched Dir</th>
                        <th title="PE − CE">OI Dir</th><th title="displayed inverted: displayed = −raw (CE − PE)">MicroDev Dir (Inv)</th><th>OFI Dir</th>
                        <th title="displayed inverted: displayed = −raw (CE − PE)">@DirectionDisplay.IvLabel</th><th title="displayed inverted: displayed = −raw (CE − PE); ×100 display scaling">@DirectionDisplay.DeltaLabel</th><th title="displayed inverted: displayed = −raw (CE − PE); ×100 display scaling">@DirectionDisplay.VegaLabel</th><th>Activity Dir</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in total.Rows)
                    {
                        <tr data-window="@r.Window.Name">
                            <td class="sticky-col">@r.Window.Name</td>
                            <td title="@CoverageTitle(r.Coverage)" data-coverage="@r.Coverage.Status">@r.Coverage.Text@Deficits(r.Coverage, TotalFamilies)</td>
                            @if (r.Direction is null)
                            {
                                @for (var i = 0; i < 11; i++) { <td>—</td> }
                            }
                            else
                            {
                                var d = r.Direction;
                                @Dir(d.Price, 2)
                                @Dir(d.Roll, 2)
                                @Dir(d.Strict, 0)
                                @Dir(d.Enriched, 0)
                                @Dir(d.Oi, 0)
                                @Dir(MicroDevDisplay.Invert(d.MicroDev), 2)
                                @Dir(d.Ofi, 0)
                                @Dir(DirectionDisplay.Invert(d.Iv), 2)
                                @Dir(DirectionDisplay.Invert(d.Delta), 2, scale100: true)
                                @Dir(DirectionDisplay.Invert(d.Vega), 2, scale100: true)
                                @Dir(d.Activity, 1)
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@code {
    [Parameter] public MarketSummaryView? View { get; set; }

    static string Sc(SummaryMetric m) => RatioFormat.SignedClass(m.Raw);

    static string Cell(SummaryMetric m, int rawDecimals = 0) => RatioFormat.Cell(new RatioPart(m.Raw, m.Num, m.Den), rawDecimals);

    RenderFragment VixCells(MarketSummaryView v, string window) => builder =>
    {
        var seq = 0;
        void Td(string text, string? title = null)
        {
            builder.OpenElement(seq++, "td");
            if (title is not null) builder.AddAttribute(seq++, "title", title);
            builder.AddContent(seq++, text);
            builder.CloseElement();
        }

        var w = v.Vix?.FirstOrDefault(x => x.Window.Name == window);
        if (w is null) { var why = v.VixUnavailableReason ?? "not loaded"; Td("—", "VIX unavailable: " + why); Td("—"); Td("—"); Td("—"); return; }
        string Pt(VixPoint p, string fmt) => p.Value is { } x ? x.ToString(fmt, System.Globalization.CultureInfo.InvariantCulture) : p.Status == VixStatus.Stale ? "stale" : "—";
        Td(Pt(w.End, "0.00"), w.End.Status == VixStatus.Stale ? $"last observation {w.End.AgeSeconds:0}s old at the boundary (limit {VixSummaryCalculator.FreshnessLimit.TotalSeconds:0}s)" : null);
        Td(w.Change is { } c ? c.ToString("+0.00;-0.00;0.00", System.Globalization.CultureInfo.InvariantCulture) : "—", w.Change is null ? "needs a fresh VIX at both the window start and end" : null);
        Td(w.ChangePct is { } p ? p.ToString("+0.00;-0.00;0.00", System.Globalization.CultureInfo.InvariantCulture) : "—");
        Td(w.End.AgeSeconds is { } a ? $"{a:0}s" : "—");
    };

    static readonly string[] TotalFamilies = ["Price", "Roll", "Strict", "Enriched", "Oi", "MicroDev", "Ofi", "Iv", "Delta", "Vega", "Activity"];

    /// <summary>Visible per-family coverage, only where a metric family has fewer usable contracts than the grid expects (e.g. " · OFI 0/10 · Delta 0/10"). Nothing is shown when every family is complete.</summary>
    static string Deficits(Coverage c, string[] families)
    {
        if (c.Status == CoverageStatus.Insufficient || c.Families is null) return "";
        var parts = families.Where(f => c.FamilyCount(f) < c.Expected).Select(f => $"{f} {c.FamilyCount(f)}/{c.Expected}").ToList();
        return parts.Count == 0 ? "" : " · " + string.Join(" · ", parts);
    }

    static string CoverageTitle(Coverage c) =>
        c.Status == CoverageStatus.Full ? "all expected contracts have every bar of the window"
        : $"{(string.IsNullOrEmpty(c.Reason) ? "" : c.Reason + "; ")}missing/partial: {(c.MissingTokens.Count == 0 ? "none listed" : string.Join(", ", c.MissingTokens))}";

    static string Describe(GridSummary g, Basket b) =>
        $"{g.Expected} contracts: " + string.Join(", ", b.For(g.Kind).Select(c => c.Token is null ? $"{(c.IsCall ? "CE" : "PE")} offset {c.Offset:+0;-0;0} (unresolved)" : $"{(c.IsCall ? "CE" : "PE")} {c.Strike:0}"));

    /// <summary>One Direction cell: signed tint on the sign of the defined Direction metric (sign only, no threshold); zero, missing and non-finite stay neutral. ×100 is display scaling and never changes the sign.</summary>
    static RenderFragment Dir(SummaryMetric m, int decimals, bool scale100 = false) => builder =>
    {
        var shown = new RatioPart(scale100 ? DisplayScale.Times100(m.Raw) : m.Raw, m.Num, m.Den);
        builder.OpenElement(0, "td");
        var cls = RatioFormat.SignedClass(shown.Raw);
        if (cls.Length > 0) builder.AddAttribute(1, "class", cls);
        builder.AddAttribute(2, "data-sign", RatioFormat.SignName(shown.Raw));
        builder.AddContent(3, RatioFormat.Cell(shown, decimals));
        builder.CloseElement();
    };
}
