@implements IAsyncDisposable
@using NiftySignal.Dashboard.Services
@using NiftySignal.Domain.Enums
@using NiftySignal.Features
@inject LiveDataService Live
@inject IJSRuntime JS

<div class="panel chain-panel">
    <div class="panel-title">
        Option Chain &mdash; NIFTY (nearest weekly)
        <span class="text-faint" style="font-weight:400; text-transform:none;">ATM highlighted</span>
    </div>

    <div class="oi-chart">
        <canvas id="oi-profile-chart"></canvas>
    </div>

    <div class="scroll-x">
        <table class="data-table chain-table">
            <thead>
                <tr>
                    <th>Strike</th>
                    <th>Type</th>
                    <th>LTP</th>
                    <th>OI</th>
                    <th>OI %</th>
                    <th>IV</th>
                    <th>Depth Imb.</th>
                    <th>Buildup</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Live.OptionChain.OrderBy(r => r.Strike).ThenBy(r => r.OptionType))
                {
                    <tr class="@(row.IsAtm ? "atm-row" : "")">
                        <td class="mono">@row.Strike.ToString("0")@(row.IsAtm ? " •" : "")</td>
                        <td><span class="badge @(row.OptionType == OptionType.Call ? "badge-bull" : "badge-bear")">@(row.OptionType == OptionType.Call ? "CE" : "PE")</span></td>
                        <td>@row.Ltp.ToString("0.00")</td>
                        <td>@row.OpenInterest.ToString("N0")</td>
                        <td class="@(row.OiChangePct >= 0 ? "text-bull" : "text-bear")">@row.OiChangePct.ToString("+0.0;-0.0")%</td>
                        <td>@(row.ImpliedVolatility is { } iv ? $"{iv * 100:0.0}%" : "—")</td>
                        <td class="@(row.DepthImbalance >= 0 ? "text-bull" : "text-bear")">@row.DepthImbalance.ToString("+0.00;-0.00")</td>
                        <td><span class="badge @BuildupClass(row.Buildup)">@FormatBuildup(row.Buildup)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    IJSObjectReference? _module;
    bool _rendered;

    static string BuildupClass(OiBuildupClassification b) => b switch
    {
        OiBuildupClassification.LongBuildup => "badge-bull",
        OiBuildupClassification.ShortCovering => "badge-bull",
        OiBuildupClassification.ShortBuildup => "badge-bear",
        OiBuildupClassification.LongUnwinding => "badge-bear",
        _ => "badge-neutral",
    };

    static string FormatBuildup(OiBuildupClassification b) => b switch
    {
        OiBuildupClassification.LongBuildup => "Long Buildup",
        OiBuildupClassification.ShortBuildup => "Short Buildup",
        OiBuildupClassification.LongUnwinding => "Long Unwinding",
        OiBuildupClassification.ShortCovering => "Short Covering",
        _ => "Neutral",
    };

    protected override void OnInitialized() => Live.Updated += OnDemoUpdated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await RenderChart();
            _rendered = true;
        }
    }

    (string[] Labels, double[] CallOi, double[] PutOi) BuildOiSeries()
    {
        var strikes = Live.OptionChain.Select(r => r.Strike).Distinct().OrderBy(s => s).ToArray();
        var calls = strikes.Select(s => (double)(Live.OptionChain.FirstOrDefault(r => r.Strike == s && r.OptionType == OptionType.Call)?.OpenInterest ?? 0)).ToArray();
        var puts = strikes.Select(s => -(double)(Live.OptionChain.FirstOrDefault(r => r.Strike == s && r.OptionType == OptionType.Put)?.OpenInterest ?? 0)).ToArray();
        return (strikes.Select(s => s.ToString("0")).ToArray(), calls, puts);
    }

    async Task RenderChart()
    {
        if (_module is null) return;

        // Two real series -- call OI (positive, green) and put OI (negative, red) -- sharing
        // one strike axis, mirrored around zero: the standard "OI profile" read for where
        // resistance/support sits. A single series can't show both sides at once.
        var (labels, calls, puts) = BuildOiSeries();
        await _module.InvokeVoidAsync("renderDivergingBarChart", "oi-profile-chart", labels, calls, puts, "#22c55e", "#f87171");
    }

    async void OnDemoUpdated()
    {
        await InvokeAsync(async () =>
        {
            StateHasChanged();
            if (_rendered && _module is not null)
            {
                var (labels, calls, puts) = BuildOiSeries();
                await _module.InvokeVoidAsync("updateDivergingBarChart", "oi-profile-chart", labels, calls, puts);
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        Live.Updated -= OnDemoUpdated;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit is already gone (tab closed, navigation) -- nothing to clean up client-side.
            }
        }
    }
}
