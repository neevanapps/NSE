@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using NiftySignal.Dashboard.Services
@using NiftySignal.Domain.Entities
@using NiftySignal.Domain.Enums
@using NiftySignal.Persistence
@inject IDbContextFactory<NiftySignalDbContext> DbFactory
@inject LiveDataService Live
@* Resolved lazily and only in capture mode, so normal Dashboard behaviour has no new dependency. *@
@inject IServiceProvider Services

    <div class="panel quote-panel" data-testid="live-quote" data-capture-ready="@(CaptureMode ? (_captureReady ? "true" : "false") : null)">
        <div class="panel-title">NIFTY Live Quote
            @if (CaptureMode)
            {
                <span class="text-faint quote-asof">pinned as of @AsOfBoundaryText · bar @CaptureBarSeq</span>
            }
            else if (!_sessionValid) { <span class="badge badge-warn">Session metadata stale — check login</span> }
        </div>
        @if (CaptureMode && _pinned?.UnavailableReason is { } reason)
        {
            <div class="text-faint quote-unavailable">@reason</div>
        }

        <div class="quote-row">
            <div class="quote-group">
                <div class="quote-stat">
                    <span class="text-faint">Spot</span>
                    <span class="mono quote-value">@FormatPriceWithChange(SpotPrice, SpotChangeValue)</span>
                    @if (CaptureMode) { <span class="text-faint quote-asof">@AsOfText(_pinned?.Spot)</span> }
                </div>
                <div class="quote-stat">
                    <span class="text-faint">Future</span>
                    <span class="mono quote-value">@FormatPriceWithChange(FuturePrice, FutureChangeValue)</span>
                    @if (CaptureMode) { <span class="text-faint quote-asof">@AsOfText(_pinned?.Future)</span> }
                </div>
                <div class="quote-stat">
                    <span class="text-faint">VIX</span>
                    <span class="mono quote-value">@FormatPriceWithChange(VixPrice, VixChangeValue)</span>
                    @if (CaptureMode) { <span class="text-faint quote-asof">@AsOfText(_pinned?.Vix)</span> }
                </div>
                @* Gamma Flip is derived from the current live option chain; it cannot be reproduced as of a past bar, so a pinned capture omits it. *@
                @if (!CaptureMode)
                {
                    <div class="quote-stat" title="Spot level where net Gamma Exposure crosses zero -- above it, dealer hedging tends to dampen moves; below it, to accelerate them.">
                        <span class="text-faint">Gamma Flip</span>
                        <span class="mono quote-value">@FormatGammaFlip()</span>
                    </div>
                }
            </div>

            <div class="quote-spacer"></div>

            <div class="quote-group quote-group-right">
                <div class="quote-stat">
                    <span class="badge badge-bull">CE</span>
                    @if (CaptureMode)
                    {
                        <span class="quote-select quote-strike" aria-label="Nifty call strike">@FormatStrike(_pinned?.CallStrike)</span>
                    }
                    else
                    {
                        <select class="quote-select" aria-label="Nifty call strike" @bind="_selectedCallStrike" @bind:after="OnCallStrikeChanged">
                            @foreach (var strike in Strikes)
                            {
                                <option @key="strike" value="@strike" selected="@(strike == _selectedCallStrike)">@strike.ToString("0")</option>
                            }
                        </select>
                    }
                    <span class="mono quote-value">@FormatQuote(CallRow, _callPending, CaptureMode ? "unavailable" : "waiting for data…")</span>
                    @if (CaptureMode) { <span class="text-faint quote-asof">@AsOfText(_pinned?.Call)</span> }
                </div>

                <div class="quote-stat">
                    <span class="badge badge-bear">PE</span>
                    @if (CaptureMode)
                    {
                        <span class="quote-select quote-strike" aria-label="Nifty put strike">@FormatStrike(_pinned?.PutStrike)</span>
                    }
                    else
                    {
                        <select class="quote-select" aria-label="Nifty put strike" @bind="_selectedPutStrike" @bind:after="OnPutStrikeChanged">
                            @foreach (var strike in Strikes)
                            {
                                <option @key="strike" value="@strike" selected="@(strike == _selectedPutStrike)">@strike.ToString("0")</option>
                            }
                        </select>
                    }
                    <span class="mono quote-value">@FormatQuote(PutRow, _putPending, CaptureMode ? "unavailable" : "waiting for data…")</span>
                    @if (CaptureMode) { <span class="text-faint quote-asof">@AsOfText(_pinned?.Put)</span> }
                </div>
            </div>
        </div>
    </div>


@code {
    const decimal StrikeInterval = 50m;
    const int StrikeRangeCount = 20; // each side of ATM -- wider than the tracked ATM+/-10 band on purpose, so a pick outside it is possible

    decimal? _selectedCallStrike;
    decimal? _selectedPutStrike;
    bool _callPending;
    bool _putPending;
    bool _sessionValid;

    bool _disposed;

    // Capture mode (Telegram screenshot): the same component, fed by deterministic as-of data pinned to a
    // completed bar instead of live state. See docs/FUTURES_GRID_PLAN_2026-10-08.md section 18.
    [Parameter] public bool CaptureMode { get; set; }
    [Parameter] public long? CaptureSessionId { get; set; }
    [Parameter] public int CaptureBarSeq { get; set; }
    PinnedQuoteSnapshot? _pinned;
    bool _captureReady;

    decimal? SpotPrice => CaptureMode ? _pinned?.Spot?.Quote.Ltp : Live.SpotLtp;
    decimal? SpotChangeValue => CaptureMode ? _pinned?.Spot?.Quote.Change : Live.SpotChange;
    decimal? FuturePrice => CaptureMode ? _pinned?.Future?.Quote.Ltp : Live.FutureLtp;
    decimal? FutureChangeValue => CaptureMode ? _pinned?.Future?.Quote.Change : Live.FutureChange;
    decimal? VixPrice => CaptureMode ? _pinned?.Vix?.Quote.Ltp : Live.VixLtp;
    decimal? VixChangeValue => CaptureMode ? _pinned?.Vix?.Quote.Change : Live.VixChange;

    string AsOfBoundaryText => _pinned?.BoundaryUtc is { } b ? IstText(b) + " IST" : "—";
    static string IstText(DateTimeOffset x) => x.ToOffset(TimeSpan.FromHours(5.5)).ToString("HH:mm:ss");
    // Each pinned quote shows the availability time of the tick it came from, so staleness is visible without a threshold.
    static string AsOfText(PinnedQuote? q) => q is null ? string.Empty : "@ " + IstText(q.AvailableAtUtc);
    static string FormatStrike(decimal? strike) => strike is { } s ? s.ToString("0") : "—";

    IEnumerable<decimal> Strikes => BuildStrikes(Live.SpotLtp,
        Live.QuickQuotes.Keys.Select(x => x.Strike), _selectedCallStrike, _selectedPutStrike);

    internal static IReadOnlyList<decimal> BuildStrikes(decimal? spot, IEnumerable<decimal> available,
        decimal? selectedCall, decimal? selectedPut)
    {
        var known = available.Where(x => x > 0).Distinct().OrderBy(x => x).ToArray();
        var center = spot is > 0 ? Math.Round(spot.Value / StrikeInterval) * StrikeInterval
            : known.Length > 0 ? known[known.Length / 2] : 0m;
        var strikes = new SortedSet<decimal>(known);
        if (center > 0)
            for (var i = -StrikeRangeCount; i <= StrikeRangeCount; i++)
                if (center + i * StrikeInterval > 0) strikes.Add(center + i * StrikeInterval);
        if (selectedCall is > 0) strikes.Add(selectedCall.Value);
        if (selectedPut is > 0) strikes.Add(selectedPut.Value);
        return strikes.ToArray();
    }

    void SeedSelection()
    {
        var strikes = Live.QuickQuotes.Keys.Select(x => x.Strike).Where(x => x > 0).Distinct().ToArray();
        if (strikes.Length == 0) return; // Never freeze zero before the first quote arrives.
        var initial = Live.SpotLtp is > 0 ? strikes.OrderBy(x => Math.Abs(x - Live.SpotLtp.Value)).ThenBy(x => x).First()
            : strikes.OrderBy(x => x).ElementAt(strikes.Length / 2);
        _selectedCallStrike ??= initial;
        _selectedPutStrike ??= initial;
    }

    QuickQuote? CallRow => CaptureMode ? _pinned?.Call?.Quote : _selectedCallStrike is { } s && Live.QuickQuotes.TryGetValue((s, OptionType.Call), out var q) ? q : null;

    QuickQuote? PutRow => CaptureMode ? _pinned?.Put?.Quote : _selectedPutStrike is { } s && Live.QuickQuotes.TryGetValue((s, OptionType.Put), out var q) ? q : null;

    protected override async Task OnInitializedAsync()
    {
        if (CaptureMode)
        {
            try { _pinned = await Services.GetRequiredService<AdaptiveQuoteAsOfService>().LoadAsync(CaptureSessionId, CaptureBarSeq); }
            catch (Exception ex) { _pinned = PinnedQuoteSnapshot.Unavailable($"Pinned quote failed ({ex.GetType().Name})."); }
            _captureReady = true;
            return;
        }

        await RefreshSessionValidityAsync();
        SeedSelection();
        Live.Updated += OnLiveUpdated;
        Live.QuoteUpdated += OnQuoteUpdated;
    }

    async Task RefreshSessionValidityAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var session = await db.FlatTradeSessions.FindAsync(FlatTradeSession.SingletonId);
        _sessionValid = session?.IsValidAt(DateTimeOffset.UtcNow) ?? false;
    }

    async Task OnCallStrikeChanged()
    {
        if (_selectedCallStrike is not { } strike)
        {
            return;
        }

        if (Live.QuickQuotes.ContainsKey((strike, OptionType.Call)))
        {
            return;
        }

        _callPending = true;
        StateHasChanged();
        try { await Live.RequestSubscriptionAsync(strike, OptionType.Call); }
        finally { _callPending = false; }
    }

    async Task OnPutStrikeChanged()
    {
        if (_selectedPutStrike is not { } strike)
        {
            return;
        }

        if (Live.QuickQuotes.ContainsKey((strike, OptionType.Put)))
        {
            return;
        }

        _putPending = true;
        StateHasChanged();
        try { await Live.RequestSubscriptionAsync(strike, OptionType.Put); }
        finally { _putPending = false; }
    }

    static string FormatPrice(decimal? price) => price is { } p ? p.ToString("0.00") : "—";

    static string FormatPriceWithChange(decimal? price, decimal? change)
    {
        if (price is not { } p)
        {
            return "—";
        }

        return change is { } c ? $"{p:0.00} ({c:+0.00;-0.00})" : p.ToString("0.00");
    }

    string FormatGammaFlip()
    {
        // double.IsFinite, not just null-check (2026-09-08 live-caught): a NaN/Infinity flip
        // level -- e.g. from a near-zero time-to-expiry gamma blowing up late on expiry day --
        // would otherwise reach the (decimal)flip cast below and throw OverflowException
        // (decimal has no NaN/Infinity representation), crashing the whole Blazor circuit for
        // a single stat nobody could even read at that point anyway.
        if (Live.GammaFlipLevel is not { } flip || !double.IsFinite(flip))
        {
            return "—";
        }

        // "above/below" reads as the standard dealer-positioning regime (see the title tooltip):
        // above the flip level, spot moves tend to get dampened; below it, amplified.
        var regime = Live.SpotLtp is { } spot ? (spot >= (decimal)flip ? " (above)" : " (below)") : "";
        return $"{flip:0.0}{regime}";
    }

    static string FormatQuote(QuickQuote? row, bool pending, string missing = "waiting for data…")
    {
        if (pending)
        {
            return "requesting…";
        }

        // Newly-requested instruments take a few seconds to reach Host's poll loop, get
        // subscribed, and start producing ticks -- "waiting for data" is a real, expected
        // state here, not an error.
        if (row is null)
        {
            return missing;
        }

        return $"{FormatPriceWithChange(row.Ltp, row.Change)} · {FormatPrice(row.Bid)} / {FormatPrice(row.Ask)}";
    }

    // Slow path (5s, via Live.Updated): session-validity flip and the initial ATM-strike
    // seed only -- both change rarely, unlike the quote data itself.
    void OnLiveUpdated()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            await RefreshSessionValidityAsync();

            if (_disposed) return;
            SeedSelection();

            StateHasChanged();
        });
    }

    // Fast path (push, via Live.QuoteUpdated -- fires the instant Host forwards a tick):
    // the actual quote values this panel exists to show.
    void OnQuoteUpdated()
    {
        if (_disposed) return;
        _ = InvokeAsync(() => { if (_disposed) return; SeedSelection(); StateHasChanged(); });
    }

    public void Dispose()
    {
        _disposed = true;
        Live.Updated -= OnLiveUpdated;
        Live.QuoteUpdated -= OnQuoteUpdated;
    }
}
