@implements IDisposable
@using System.Globalization
@using NiftySignal.Dashboard.Services
@inject IServiceProvider Services

@* Compact V2 opportunity view: one deterministic outcome per strategy per verified bar (see the opportunity log). Read-only; degrades to a plain message when the table or the permission is missing. *@
<section class="panel v2-shadow" data-testid="v2-opportunities">
    <div class="panel-title">V2 OPPORTUNITIES <span class="badge badge-neutral">observation only</span>
        <span class="text-faint">signals, attempts, fills and why entries did not happen · a suppressed signal never becomes an order</span></div>
    @if (_view is null)
    {
        <div class="text-faint" data-testid="v2-opp-loading">Loading…</div>
    }
    else if (!_view.Available)
    {
        <div class="text-faint" data-testid="v2-opp-unavailable">@_view.Message</div>
    }
    else if (_view.Strategies.Count == 0)
    {
        <div class="text-faint" data-testid="v2-opp-empty">No opportunity has been recorded for @_view.TradeDate.ToString("dd-MMM-yyyy") yet.</div>
    }
    else
    {
        <div class="scroll-x"><table class="data-table" data-testid="v2-opp-counts">
            <thead><tr><th>Strategy</th><th>Bars</th><th title="directional (CE or PE) decisions">Signals</th><th title="orders attempted">Attempts</th><th title="placed orders that filled">Fills</th><th title="blocked by a holding, a pending order, the entry window or risk">Suppressed</th><th title="orders accepted but never filled before expiry">Expired</th></tr></thead>
            <tbody>
            @foreach (var s in _view.Strategies)
            {
                <tr data-strategy="@s.StrategyId"><td>@s.StrategyId</td><td>@s.Bars</td><td>@s.Signals</td><td>@s.Attempts</td><td>@s.Fills</td><td>@s.Suppressed</td><td>@s.Expired</td></tr>
            }
            </tbody>
        </table></div>
        @if (_view.Rejections.Count > 0)
        {
            <div class="adaptive-subtitle">WHY ENTRIES DID NOT HAPPEN</div>
            <div class="scroll-x"><table class="data-table" data-testid="v2-opp-rejections">
                <thead><tr><th>Category</th><th>Reason</th><th>Count</th></tr></thead>
                <tbody>
                @foreach (var r in _view.Rejections)
                {
                    <tr><td>@r.Category</td><td>@r.Reason</td><td>@r.Count</td></tr>
                }
                </tbody>
            </table></div>
        }
        @if (_view.Recent.Count > 0)
        {
            <div class="adaptive-subtitle">RECENT (newest first, at most 25)</div>
            <div class="scroll-x"><table class="data-table" data-testid="v2-opp-recent">
                <thead><tr><th>IST</th><th>Strategy</th><th>Bar</th><th>Stage</th><th>Dir</th><th>Category</th><th>Reason</th><th>Order</th></tr></thead>
                <tbody>
                @foreach (var r in _view.Recent)
                {
                    <tr title="@r.Detail"><td>@((r.At + TimeSpan.FromHours(5.5)).ToString("HH:mm:ss", CultureInfo.InvariantCulture))</td><td>@r.StrategyId</td><td>@r.BarSeq</td><td>@r.Stage</td><td>@r.Direction</td><td>@r.Category</td><td>@r.Reason</td><td>@r.OrderResult</td></tr>
                }
                </tbody>
            </table></div>
        }
    }
</section>

@code {
    static readonly TimeSpan Refresh = TimeSpan.FromSeconds(15);

    V2OpportunityView? _view;
    PaperEngineV2DataService? _service;
    Timer? _timer;
    int _busy;

    protected override async Task OnInitializedAsync()
    {
        _service = Services.GetService(typeof(PaperEngineV2DataService)) as PaperEngineV2DataService;
        var day = PaperEngineV2DataService.IstDate(DateTimeOffset.UtcNow);
        if (_service is null) { _view = V2OpportunityView.Unavailable(day, "the V2 database is not configured for this dashboard"); return; }
        await LoadAsync();
        _timer = new Timer(_ => _ = InvokeAsync(LoadAsync), null, Refresh, Refresh);
    }

    async Task LoadAsync()
    {
        if (_service is null || Interlocked.Exchange(ref _busy, 1) == 1) return;
        try
        {
            _view = await _service.LoadOpportunitiesAsync(PaperEngineV2DataService.IstDate(DateTimeOffset.UtcNow), CancellationToken.None);
            StateHasChanged();
        }
        finally { Volatile.Write(ref _busy, 0); }
    }

    public void Dispose() => _timer?.Dispose();
}
