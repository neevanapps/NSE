@implements IAsyncDisposable
@using NiftySignal.Dashboard.Services
@using NiftySignal.Domain
@inject LiveDataService Live
@inject IJSRuntime JS

<div class="panel ratio-score-panel">
    <div class="panel-title">
        Ratio Composite Score
        <span class="text-faint" style="font-weight:400; text-transform:none; letter-spacing:normal;">experimental sidecar, not wired to trading (audit F35)</span>
    </div>

    <div class="score-top">
        <div class="score-readout">
            @if (Live.CurrentRatioScore is { } score)
            {
                <div class="score-number @ScoreColorClass(score)">@score.ToString("+0;-0;0")</div>
                <div class="score-label badge @ScoreBadgeClass(score)">@ScoreLabel(score)</div>
            }
            else
            {
                <div class="score-number text-faint">&mdash;</div>
                <div class="score-label badge badge-neutral">Warming Up</div>
            }
            <span class="mono text-faint components-present">@Live.RatioComponentsPresent/5 metrics</span>
        </div>
        <div class="score-chart">
            <canvas id="ratio-score-history-chart"></canvas>
        </div>
    </div>

    <div class="components">
        @foreach (var c in Live.RatioScoreComponents)
        {
            <div class="component-row">
                <span class="health-dot @(c.IsPresent ? "ok" : "pending")" title="@(c.IsPresent ? "Present this cadence" : "Below its liquidity floor this cadence")"></span>
                <span class="component-name text-dim">@FormatName(c.Name)</span>
                <div class="component-bar-track">
                    @if (c.ClippedValue is { } clipped)
                    {
                        <div class="component-bar @(clipped >= 0 ? "bull" : "bear")" style="@BarStyle(clipped)"></div>
                    }
                </div>
                <span class="mono text-faint component-weight">w=@c.Weight.ToString("0.00")</span>
                <span class="mono @(c.ClippedValue is { } s && s >= 0 ? "text-bull" : c.ClippedValue is null ? "text-faint" : "text-bear") component-z">@(c.ClippedValue is { } v ? $"s={v:+0.00;-0.00}" : "s=--")</span>
            </div>
        }
    </div>
</div>

@code {
    IJSObjectReference? _module;
    bool _rendered;

    static string ScoreColorClass(double score) => score switch
    {
        > 10 => "text-bull",
        < -10 => "text-bear",
        _ => "text-dim",
    };

    static string ScoreBadgeClass(double score) => score switch
    {
        > 10 => "badge-bull",
        < -10 => "badge-bear",
        _ => "badge-neutral",
    };

    static string ScoreLabel(double score) => score switch
    {
        > 55 => "Strongly Bullish",
        > 10 => "Bullish",
        < -55 => "Strongly Bearish",
        < -10 => "Bearish",
        _ => "Neutral",
    };

    static string FormatName(string name) => name switch
    {
        "NotionalVolumeRatio" => "Notional Volume Ratio",
        "SizedOiFlowRatio" => "Sized OI Flow Ratio",
        "ResidualDifference" => "Residual Call-Put",
        "IvSkew25Delta" => "IV Skew (25-delta)",
        "SpreadRatioAtm" => "Spread Ratio (ATM)",
        _ => name,
    };

    // [-1,1] clipped inputs, not unbounded z-scores -- the bar's full-scale denominator is 1,
    // not ScorePanel's 3 (see BarStyle there).
    static string BarStyle(double s)
    {
        var pct = Math.Min(100, Math.Abs(s) * 100);
        var side = s >= 0 ? "left" : "right";
        return $"width:{pct.ToString("0")}%; {side}: 50%;";
    }

    protected override void OnInitialized() => Live.Updated += OnDemoUpdated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await RenderChart();
            _rendered = true;
        }
    }

    (string[] Labels, double[] Scores, double?[] Prices) BuildSeries()
    {
        var history = Live.RatioScoreHistory;
        return (
            history.Select(h => h.Timestamp.ToIst().ToString("HH:mm:ss")).ToArray(),
            history.Select(h => Math.Round(h.Score, 1)).ToArray(),
            history.Select(h => h.SpotPrice).ToArray());
    }

    async Task RenderChart()
    {
        if (_module is null) return;
        var (labels, scores, prices) = BuildSeries();
        await _module.InvokeVoidAsync("renderScoreWithPriceChart", "ratio-score-history-chart", labels, scores, prices, "#a78bfa", "#fbbf24");
    }

    // Same async-void circuit-teardown handling as ScorePanel -- see that component's own doc
    // comment on OnDemoUpdated for why the three exception types below are expected, not bugs.
    async void OnDemoUpdated()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                StateHasChanged();
                if (_rendered && _module is not null)
                {
                    var (labels, scores, prices) = BuildSeries();
                    await _module.InvokeVoidAsync("updateScoreWithPriceChart", "ratio-score-history-chart", labels, scores, prices);
                }
            });
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // This circuit is going away -- nothing to update client-side.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.Updated -= OnDemoUpdated;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit is already gone (tab closed, navigation) -- nothing to clean up client-side.
            }
        }
    }
}
