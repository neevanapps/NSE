@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using NiftySignal.Dashboard.Components.Dashboard

<PageTitle>NiftySignal Adaptive Observer</PageTitle>

<div class="dashboard-shell">
    @* Existing operational header/status row remains unchanged. *@
    <StatusBar />

    @* Existing access-token controls and Live Quote remain on the primary page unchanged.
       The adaptive observer starts below them. *@
    <div class="dashboard-grid">
        <FlatTradeLoginPanel />
        <LiveQuotePanel />
    </div>

    <CommentaryPanel />

    <AdaptiveObserverPanel />
    <p style="padding:20px"><a href="/adaptive-screenshots">Telegram screenshots — status / pre-live test</a></p>
</div>
