@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using NiftySignal.Dashboard.Components.Dashboard

<PageTitle>NiftySignal Adaptive Observer</PageTitle>

<div class="dashboard-shell">
    @* Existing operational header/status row remains unchanged. *@
    <StatusBar />

    @* Existing access-token controls and Live Quote remain on the primary page unchanged.
       The adaptive observer starts below them. *@
    @* Live Quote: a direct child of the shell so it can stay pinned while the whole page scrolls (sticky only works within its parent). *@
    <LiveQuotePanel />

    <div class="dashboard-grid">
        <FlatTradeLoginPanel />
    </div>

    <ToastHost />

    <CommentaryPanel />

    <AdaptiveObserverPanel />
    <p style="padding:20px"><a href="/adaptive-screenshots">Telegram screenshots — status / pre-live test</a> · <a href="/paper-live">Paper trading (read-only)</a></p>
</div>
