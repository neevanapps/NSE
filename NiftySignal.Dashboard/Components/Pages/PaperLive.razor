@page "/paper-live"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using NiftySignal.Dashboard.Services
@inject PaperLiveDataService Data
@inject Npt1LiveQuotes Quotes

@* READ-ONLY view of the live PAPER trading path (docs/TRADING_ENGINE_PHASE1_CONTRACT.md section B.7). There is no button, form or command on this page: it cannot buy, sell, cancel,
   kill or change anything. Everything shown is read from the durable trading ledger. *@

<PageTitle>Paper trading (read-only)</PageTitle>

<div class="dashboard-shell" style="padding:12px 20px;">
    <div style="padding: 4px 0 12px;">
        <a href="/" class="login-link">&larr; Back to dashboard</a>
    </div>
    <h1 style="font-size:20px;">NPT1 PAPER — TODAY <span class="badge badge-neutral">PAPER ONLY - read-only</span></h1>

    @if (!Data.Configured)
    {
        <p class="text-faint">The paper-trading database is not configured for this dashboard (ConnectionStrings:TradingPaperLive).</p>
    }
    else if (_error is not null)
    {
        <p class="text-faint">The paper-trading ledger could not be read: @_error</p>
    }
    else if (_view is null)
    {
        <p class="text-faint">No paper-trading run has been recorded yet.</p>
    }
    else
    {
        var s = _view.Status;
        var stale = !s.Completed && s.LastStepEngineTime is { } last && DateTimeOffset.UtcNow - last > TimeSpan.FromMinutes(2);

        @if (_today is { } td)
        {
            var now = DateTimeOffset.UtcNow;
            var running = PaperTodayProjection.Running(td.Open, Quotes.Snapshot(), now);
            <div class="panel" data-testid="paper-header">
                <div class="paper-header-line">
                    <b>@td.Header.TradeDate.ToString("dd-MMM-yyyy")</b>
                    <span>M1: <b class="@(td.Header.M1Status == "LIVE" ? "paper-live-ok" : "paper-live-warn")">@td.Header.M1Status</b></span>
                    <span>Bar: <b>@(td.Header.Bar?.ToString() ?? "—")</b></span>
                    <span>Capital: <b>@Rupees(td.Header.Capital)</b></span>
                    <span>Open exposure: <b>@Rupees(td.Header.OpenExposure)</b></span>
                    <span>Integrity: <b>@td.Header.Integrity</b></span>
                </div>
                <div class="paper-strategy-states" data-testid="paper-strategy-states">
                    @foreach (var row in td.Strategies)
                    {
                        <span class="badge badge-neutral">@ShortName(row.StrategyId) &nbsp; @row.State</span>
                    }
                </div>
            </div>

            <div class="panel" data-testid="running-trades">
                <div class="panel-title">RUNNING TRADES <span class="mono text-dim">@running.Count</span></div>
                @if (running.Count == 0)
                {
                    <div class="text-faint" style="font-size:13px;">No running trades.</div>
                }
                else
                {
                    <div class="scroll-x"><table class="data-table">
                        <thead><tr><th>Strategy</th><th>Side</th><th>Strike</th><th>Symbol</th><th>Entry time</th><th>Entry price</th><th>Bid</th><th>Ask</th><th>LTP</th><th>Qty</th>
                            <th title="Tick-level display value = (current bid - entry price) x quantity. It is not stored and does not change the strategy ledger.">Live P&amp;L @@ Bid</th>
                            <th title="MFE / MAE follow the tested bar-end strategy definition (not tick level).">MFE</th><th>MAE</th><th>Holding</th><th>Quote age</th><th>Exit pending</th></tr></thead>
                        <tbody>
                        @foreach (var r in running)
                        {
                            <tr data-token="@r.Token">
                                <td>@ShortName(r.StrategyId)</td><td>@r.Side</td><td>@r.Strike</td><td>@r.Symbol</td><td>@Ist(r.EntryAt)</td><td>@Px(r.EntryPrice)</td>
                                <td>@Px(r.Bid)</td><td>@Px(r.Ask)</td><td>@Px(r.Ltp)</td><td>@r.Quantity</td>
                                <td class="@PnlClass(r.LivePnlAtBid)" data-testid="live-pnl">@Money(r.LivePnlAtBid)</td>
                                <td>@Money(r.Mfe)</td><td>@Money(r.Mae)</td>
                                <td>@Span(r.HoldingTime)</td>
                                <td>@(r.QuoteAge is { } age ? Span(age) : "no quote")</td>
                                <td>@(r.ExitPending ? "YES" : "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    <div class="text-faint" style="font-size:12px; margin-top:4px;">Live P&amp;L is a tick-level display value at the executable bid. MFE / MAE follow the tested bar-end strategy definition.</div>
                }
            </div>

            <div class="panel" data-testid="completed-trades">
                <div class="panel-title">TODAY'S COMPLETED TRADES <span class="mono text-dim">@td.Completed.Count</span></div>
                @if (td.Completed.Count == 0)
                {
                    <div class="text-faint" style="font-size:13px;">No completed trades today.</div>
                }
                else
                {
                    <div class="scroll-x"><table class="data-table">
                        <thead><tr><th>Strategy</th><th>Side</th><th>Strike</th><th>Symbol</th><th>Entry time</th><th>Entry price</th><th>Exit time</th><th>Exit price</th><th>Qty</th><th>Exit reason</th><th>Gross</th><th>Fees</th><th>Net</th><th>MFE</th><th>MAE</th></tr></thead>
                        <tbody>
                        @foreach (var c in td.Completed)
                        {
                            <tr>
                                <td>@ShortName(c.StrategyId)</td><td>@c.Side</td><td>@c.Strike</td><td>@c.Symbol</td><td>@Ist(c.EntryAt)</td><td>@Px(c.EntryPrice)</td><td>@Ist(c.ExitAt)</td><td>@Px(c.ExitPrice)</td>
                                <td>@c.Quantity</td><td>@c.ExitReason</td><td>@Money(c.Gross)</td><td>@Money(c.Fees)</td><td class="@PnlClass(c.Net)">@Money(c.Net)</td><td>@Money(c.Mfe)</td><td>@Money(c.Mae)</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
            </div>

            <div class="panel" data-testid="strategy-summary">
                <div class="panel-title">TODAY'S STRATEGY SUMMARY <span class="text-dim" style="font-size:12px;">(each strategy on its own; not a portfolio result)</span></div>
                <table class="data-table">
                    <thead><tr><th>Strategy</th><th>Trades</th><th>Wins</th><th>Losses</th><th>Closed Net</th><th>Current state</th></tr></thead>
                    <tbody>
                    @foreach (var row in td.Strategies)
                    {
                        <tr><td>@ShortName(row.StrategyId)</td><td>@row.Trades</td><td>@row.Wins</td><td>@row.Losses</td><td class="@PnlClass(row.ClosedNet)">@Money(row.ClosedNet)</td><td>@row.State</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="panel"><div class="text-faint" style="font-size:13px;">No NPT1 paper run is recorded for today.</div></div>
        }

        <details class="panel paper-diagnostics" data-testid="paper-diagnostics">
        <summary class="panel-title" style="cursor:pointer;">Diagnostics</summary>
        <div class="panel">
            <div class="panel-title">Engine status <span class="mono text-dim">@s.RunId</span></div>
            @foreach (var p in s.Problems)
            {
                <div class="badge badge-bear" style="display:block; margin:4px 0;">@p</div>
            }
            <table class="data-table">
                <tbody>
                    <tr><td>Trade date</td><td>@s.TradeDate.ToString("yyyy-MM-dd")</td><td>Session</td><td>@(s.Completed ? "finished (final close done)" : "running")</td></tr>
                    <tr><td>Last finalized bar</td><td>@(s.LastBarSeq?.ToString() ?? "none yet")</td><td>Last input group</td><td>@Ist(s.LastGroupAt)</td></tr>
                    <tr><td>Last committed step (engine time)</td><td>@Ist(s.LastStepEngineTime) @if (stale) { <span class="badge badge-bear">no commit for over 2 minutes</span> }</td><td>Last recovery event</td><td>@(s.LastRecoveryOutcome ?? "-") <span class="text-dim">@s.LastRecoveryDetail</span></td></tr>
                    <tr><td>Steps / inputs / outputs</td><td>@s.Steps / @s.Inputs / @s.Outputs</td><td>Owner</td><td class="mono">@(s.OwnerId ?? "-")</td></tr>
                </tbody>
            </table>
        </div>

        @if (_npt1 is not null)
        {
            <div class="panel">
                <div class="panel-title">NPT1 strategies <span class="badge badge-neutral">each strategy has its own position and ledger</span></div>
                <div class="text-faint" style="font-size:12px; margin-bottom:6px;">@_npt1.Note</div>
                @if (_npt1.Stream is { } st)
                {
                    <table class="data-table"><tbody>
                        <tr><td>M1 stream</td><td>@st.Status @if (st.DivergentFrames > 0) { <span class="badge badge-bear">@st.DivergentFrames divergent frame(s)</span> }</td><td>Last heartbeat</td><td>@Ist(st.LastHeartbeat)</td></tr>
                        <tr><td>Last M1 bar</td><td>@st.LastBarSeq (ended @Ist(st.LastBarEnd))</td><td>Base bar volume</td><td>@(st.BaseBarVolume?.ToString("N0") ?? "-") <span class="text-dim">@st.BarSizeStatus, opening @(st.OpeningVolume?.ToString("N0") ?? "-")</span></td></tr>
                        <tr><td>Polls / rows read</td><td>@st.Polls.ToString("N0") / @st.RowsRead.ToString("N0")</td><td>Poll ms (last / max)</td><td>@st.LastPollMillis.ToString("0.0") / @st.MaxPollMillis.ToString("0.0")</td></tr>
                    </tbody></table>
                }
                else
                {
                    <div class="text-faint" style="font-size:13px;">M1 stream health is not available (the npt1m1 schema is absent or unreadable).</div>
                }

                @foreach (var n in _npt1.Strategies)
                {
                    <div class="panel-title" style="margin-top:12px;">@n.StrategyId <span class="badge badge-neutral">@n.State</span></div>
                    <table class="data-table"><tbody>
                        <tr><td>Trades / wins</td><td>@n.Trades / @n.Wins</td><td>Gross / fees / net</td><td>@n.Gross.ToString("N2") / @n.Fees.ToString("N2") / <b>@n.Net.ToString("N2")</b></td></tr>
                        <tr><td>Open position</td><td>@(n.Open is { } o ? $"{o.OptionType} {o.Symbol} entry {o.AvgEntryPrice} x{o.RemainingQuantity} (bid {o.LastBid}, unrealized {o.UnrealizedPnl})" : "none")</td><td>MFE / MAE (open)</td><td>@(n.Open is { } op ? $"{op.Mfe} / {op.Mae} ({op.Coverage})" : "-")</td></tr>
                        <tr><td>Capital committed by this strategy</td><td>@Money(n.OpenCommitted)</td><td></td><td></td></tr>
                    </tbody></table>
                    @if (n.Decisions.Count > 0)
                    {
                        <div class="scroll-x"><table class="data-table">
                            <thead><tr><th>Time (IST)</th><th>Stage</th><th>Outcome</th><th>What it saw / did</th></tr></thead>
                            <tbody>
                            @foreach (var d in n.Decisions)
                            {
                                <tr><td>@Ist(d.At)</td><td>@d.Stage</td><td>@d.Outcome</td><td class="mono" style="font-size:11px;">@d.Detail</td></tr>
                            }
                            </tbody>
                        </table></div>
                    }
                }
            </div>
        }

        <div class="panel">
            <div class="panel-title">Risk and capital</div>
            <table class="data-table">
                <tbody>
                    <tr><td>Global capital</td><td>@Money(_view.Risk.GlobalCapital)</td><td>Committed (open exposure)</td><td>@Money(_view.Risk.OpenExposure) @(_view.Risk.CapitalInUsePct is { } pct ? $"({pct}%)" : "")</td></tr>
                    <tr><td>Trades today</td><td>@_view.Risk.GlobalTrades</td><td>Realized net P&amp;L</td><td>@Money(_view.Risk.GlobalRealizedNet)</td></tr>
                    <tr><td>Feed integrity</td><td>@_view.Risk.IntegrityState</td><td>Active kill switches</td><td>@(_view.Risk.KillSwitches.Count == 0 ? "none" : string.Join(", ", _view.Risk.KillSwitches))</td></tr>
                </tbody>
            </table>
            <div class="panel-title" style="margin-top:10px;">Latest rejected entries</div>
            @if (_view.Risk.Rejections.Count == 0)
            {
                <div class="text-faint" style="font-size:13px;">None.</div>
            }
            else
            {
                <div class="scroll-x"><table class="data-table">
                    <thead><tr><th>Time (IST)</th><th>Variant</th><th>Stage</th><th>Reasons</th><th>Bar</th></tr></thead>
                    <tbody>
                    @foreach (var r in _view.Risk.Rejections)
                    {
                        <tr><td>@Ist(r.At)</td><td>@r.StrategyId/@r.VariantId</td><td>@r.Stage</td><td>@r.Reasons</td><td>@r.BarSeq</td></tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>

        <div class="panel">
            <div class="panel-title">Open positions <span class="mono text-dim">@_view.Open.Count</span></div>
            @if (_view.Open.Count == 0)
            {
                <div class="text-faint" style="font-size:13px;">No open positions.</div>
            }
            else
            {
                <div class="scroll-x"><table class="data-table">
                    <thead><tr><th>Variant</th><th>Contract</th><th>Dir</th><th>Entry (IST)</th><th>Avg entry</th><th>Qty (left)</th><th>TP1</th><th>Stop</th><th>Max-hold</th><th>Last bid</th><th>Unrealized</th><th>MFE</th><th>MAE</th><th>Cov.</th><th>As of</th></tr></thead>
                    <tbody>
                    @foreach (var p in _view.Open)
                    {
                        <tr>
                            <td>@p.StrategyId/@p.VariantId</td><td>@p.Symbol</td><td>@p.Direction (@p.OptionType)</td><td>@Ist(p.EntryAt)</td><td>@p.AvgEntryPrice</td><td>@p.EntryQuantity (@p.RemainingQuantity)</td>
                            <td>@p.Tp1State @p.Tp1Level</td><td>@p.StopLevel</td><td>@Ist(p.MaxHoldDeadline)</td><td>@p.LastBid</td><td>@p.UnrealizedPnl @if (p.ExitPending) { <span class="badge badge-neutral">exit pending</span> }</td>
                            <td>@p.Mfe (@p.MfePct%)</td><td>@p.Mae (@p.MaePct%)</td><td>@p.Coverage</td><td>@Ist(p.AsOf)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>

        <div class="panel">
            <div class="panel-title">Closed trades <span class="mono text-dim">@_view.Closed.Count</span></div>
            @if (_view.Closed.Count == 0)
            {
                <div class="text-faint" style="font-size:13px;">No closed trades.</div>
            }
            else
            {
                <div class="scroll-x"><table class="data-table">
                    <thead><tr><th>Variant</th><th>Contract</th><th>Dir</th><th>Entry</th><th>Exit</th><th>Reason</th><th>Avg in / out</th><th>Qty</th><th>Gross</th><th>Costs</th><th>Net</th><th>MFE</th><th>MAE</th><th>Cov.</th><th>Bars in / out</th></tr></thead>
                    <tbody>
                    @foreach (var t in _view.Closed)
                    {
                        <tr>
                            <td>@t.StrategyId/@t.VariantId</td><td>@t.Symbol</td><td>@t.Direction (@t.OptionType)</td><td>@Ist(t.EntryAt)</td><td>@Ist(t.ExitAt)</td><td>@t.ExitReason</td><td>@t.AvgEntryPrice / @t.AvgExitPrice</td><td>@t.Quantity</td>
                            <td>@t.Gross</td><td>@t.Costs</td><td>@t.Net</td><td>@t.Mfe (@t.MfePct%)</td><td>@t.Mae (@t.MaePct%)</td><td>@t.Coverage</td><td>@t.EntryBarSeq / @t.ExitBarSeq</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>

        <div class="panel">
            <div class="panel-title">Family and variant summary</div>
            <div class="scroll-x"><table class="data-table">
                <thead><tr><th>Scope</th><th>Trades</th><th>Open</th><th>Closed</th><th>Wins</th><th>Losses</th><th>Closed net</th><th>Consecutive losses</th><th>Avg MFE</th><th>Avg MAE</th></tr></thead>
                <tbody>
                @foreach (var f in _view.Families)
                {
                    <tr><td><b>@f.Scope</b> (family)</td><td>@f.Trades</td><td>@f.Open</td><td>@f.Closed</td><td>@f.Wins</td><td>@f.Losses</td><td>@f.ClosedNet.ToString("0.00")</td><td>@f.ConsecutiveLosses</td><td>@Num(f.AvgMfe)</td><td>@Num(f.AvgMae)</td></tr>
                }
                @foreach (var v in _view.Variants)
                {
                    <tr><td>@v.Scope</td><td>@v.Trades</td><td>@v.Open</td><td>@v.Closed</td><td>@v.Wins</td><td>@v.Losses</td><td>@v.ClosedNet.ToString("0.00")</td><td>@v.ConsecutiveLosses</td><td>@Num(v.AvgMfe)</td><td>@Num(v.AvgMae)</td></tr>
                }
                </tbody>
            </table></div>
        </div>
        </details>
    }
</div>

@code {
    private PaperLiveView? _view;
    private PaperTodayView? _today;
    private System.Threading.Timer? _uiTimer;
    private int _renderPending;
    private Npt1View? _npt1;
    private string? _error;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        Quotes.QuoteUpdated += OnQuote;
        Quotes.TradesChanged += OnTradesChanged;
        // age / holding-time labels only: no data access
        _uiTimer = new System.Threading.Timer(_ => { _ = InvokeAsync(StateHasChanged); }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        _timer = new System.Threading.Timer(async _ => { await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); }); }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task RefreshAsync()
    {
        try
        {
            var today = TodayIst();
            _view = await Data.LoadLatestAsync();
            _npt1 = _view is null ? null : await Data.LoadNpt1Async(_view);
            _today = _view is null ? null : PaperTodayProjection.Build(_view, _npt1, today, DateTimeOffset.UtcNow);
            // The durable ledger decides which tokens are held; live quotes then flow in from the existing tick push for exactly those tokens.
            Quotes.SetWatched(_today?.Open.Select(p => p.Token) ?? []);
            _error = null;
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }

    private static string Ist(DateTimeOffset? at) => at is { } a ? a.ToOffset(TimeSpan.FromHours(5.5)).ToString("HH:mm:ss") : "-";

    private static string Money(decimal? value) => value is { } v ? v.ToString("N2") : "-";

    private static string Num(decimal? value) => value is { } v ? v.ToString("0.00") : "-";

    private static DateOnly TodayIst() => DateOnly.FromDateTime(DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(5.5)).Date);

    // Ticks of a held contract can arrive many times a second: coalesce them into at most one render per 250 ms.
    private void OnQuote()
    {
        if (Interlocked.Exchange(ref _renderPending, 1) == 1) return;
        _ = Task.Run(async () =>
        {
            await Task.Delay(250);
            Interlocked.Exchange(ref _renderPending, 0);
            await InvokeAsync(StateHasChanged);
        });
    }

    // A paper trade opened or closed on the Host: re-read the durable open positions now instead of waiting for the 5 s refresh.
    private void OnTradesChanged() => _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private static string ShortName(string strategyId) => strategyId.StartsWith("NPT1-", StringComparison.Ordinal) ? strategyId[5..] : strategyId;

    private static string Rupees(decimal? v) => v is { } x ? "₹" + x.ToString("N0") : "—";

    private static string Px(decimal? v) => v is { } x ? x.ToString("0.00") : "—";

    private static string Span(TimeSpan t) => t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes:00}m" : t.TotalMinutes >= 1 ? $"{(int)t.TotalMinutes}m {t.Seconds:00}s" : $"{t.TotalSeconds:0.0}s";

    private static string PnlClass(decimal? v) => v is > 0m ? "paper-pnl-up" : v is < 0m ? "paper-pnl-down" : string.Empty;

    public void Dispose()
    {
        Quotes.QuoteUpdated -= OnQuote;
        Quotes.TradesChanged -= OnTradesChanged;
        _timer?.Dispose();
        _uiTimer?.Dispose();
    }
}
