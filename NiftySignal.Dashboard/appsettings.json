{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5210",
  "ConnectionStrings": {
    "NiftySignalDb": ""
  },
  "FlatTrade": {
    "UserId": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  // Kept in sync by hand with NiftySignal.Host/appsettings.json's own "Pricing" section --
  // see PricingOptions' own doc comment (audit finding F21) for why there isn't a single
  // shared source for this value between the two services.
  "Pricing": {
    "RiskFreeRate": 0.065
  },
  // PasswordSha256 is a hex SHA-256 of the password, set in appsettings.Local.json (never here,
  // and never the plaintext password). Generate it with (works on Windows PowerShell 5.1 --
  // SHA256.HashData is .NET 5+ only and is NOT available there):
  //   $b=[Text.Encoding]::UTF8.GetBytes("your-password"); (([Security.Cryptography.SHA256]::Create().ComputeHash($b)) | ForEach-Object { $_.ToString("x2") }) -join ""
  // Comparison is case-insensitive on the hex, so either case works.
  // Left empty deliberately: with no hash configured, sign-in refuses everyone rather than
  // falling open.
  "DashboardAuth": {
    "Username": "admin",
    "PasswordSha256": ""
  }
}
