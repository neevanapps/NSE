<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Adaptive Observer's live processing, recovery, checkpoints, persistence and publication, shared by the NiftySignalObserver service and (only when Adaptive:Observer:Process is InHost) the Host.
       It references no broker or ingestion project (asserted by a test): it reads the ticks the Host stores. Types keep the NiftySignal.Host namespace they had before the process split. -->
  <ItemGroup>
    <InternalsVisibleTo Include="NiftySignal.Host" />
    <InternalsVisibleTo Include="NiftySignal.Observer" />
    <InternalsVisibleTo Include="NiftySignal.Tests" />
    <InternalsVisibleTo Include="AdaptiveLivePerformance" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NiftySignal.AdaptiveObserver\NiftySignal.AdaptiveObserver.csproj" />
    <ProjectReference Include="..\NiftySignal.AdaptiveObserverData\NiftySignal.AdaptiveObserverData.csproj" />
    <ProjectReference Include="..\NiftySignal.Domain\NiftySignal.Domain.csproj" />
    <ProjectReference Include="..\NiftySignal.Persistence\NiftySignal.Persistence.csproj" />
    <ProjectReference Include="..\NiftySignal.Pricing\NiftySignal.Pricing.csproj" />
  </ItemGroup>

</Project>
