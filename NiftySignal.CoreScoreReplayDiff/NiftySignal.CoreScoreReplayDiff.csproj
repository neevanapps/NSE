<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Batch 3 (docs/replication_plan.md, 2026-09-13): the mandatory pre-Batch-5 gate proving
         live's CoreScoreSnapshot computation (NiftySignal.Host/LiveFeatureEngine.cs) is the SAME
         as CoreScoreOptionSimulator's backtest math, not "a cousin of it" (external review's own
         words). Read-only against both the live-schema and niftysignal_backtest_analysis
         databases; never writes anything. Per standing instruction, this is a tool the user runs
         themselves.

         Also hosts the Batch 6 (2026-09-14) "shadow" mode (`... shadow [date] [restartTimeIst]`),
         an offline dry run of both new trading engines in ShadowMode against a real historical
         day's ticks, standing in for a live-session watch on a day the exchange is closed. Uses an
         EF Core InMemory NiftySignalDbContext for the trading engines' own risk/kill-switch/data-gap
         queries only, still never writing a real row anywhere; the InMemory package below exists
         purely for that. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NiftySignal.Domain\NiftySignal.Domain.csproj" />
    <ProjectReference Include="..\NiftySignal.Persistence\NiftySignal.Persistence.csproj" />
    <ProjectReference Include="..\NiftySignal.Backtest\NiftySignal.Backtest.csproj" />
    <ProjectReference Include="..\NiftySignal.Host\NiftySignal.Host.csproj" />
    <ProjectReference Include="..\NiftySignal.BacktestData\NiftySignal.BacktestData.csproj" />
    <ProjectReference Include="..\NiftySignal.MetricTrials\NiftySignal.MetricTrials.csproj" />
    <ProjectReference Include="..\NiftySignal.Rules\NiftySignal.Rules.csproj" />
    <ProjectReference Include="..\NiftySignal.Notifications\NiftySignal.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

</Project>
