{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/niftysignal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "NiftySignalDb": ""
  },
  "KillSwitch": {
    "EntriesEnabled": true
  },
  "Telegram": {
    "BotToken": "",
    "ChatId": ""
  },
  "FlatTrade": {
    "UserId": "",
    "ApiKey": "",
    "ApiSecret": ""
  }
}
