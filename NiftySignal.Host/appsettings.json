{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/niftysignal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "NiftySignalDb": ""
  },
  "KillSwitch": {
    "EntriesEnabled": true
  },
  "Pricing": {
    "RiskFreeRate": 0.065
  },
  "Ruleset": {
    "RulesetVersion": "live-2026-09-09",
    "Capital": { "Total": 50000, "LotSize": 65, "MaxConcurrentPositions": 3, "LotsPerTrade": 2 },
    "Session": {
      "NoEntryBeforeMinutes": 15,
      "NoEntryAfterTime": "15:00",
      "SquareOffTime": "15:15",
      "ExpiryDayEnabled": true,
      "ExpiryDayNoEntryAfterTime": "14:00"
    },
    "Entry": {
      "MinAbsScore": 64,
      "MinScoreSustainedSeconds": 45,
      "ReEntryGapSameDirectionMinutes": 2,
      "MaxTradesPerDay": 30,
      "MaxIvRankForEntry": 70,
      "MinScoreSustainedCadences": 3
    },
    "StrikeSelection": {
      "MinPremium": 100,
      "MaxPremium": 150,
      "MaxSpreadPctOfMid": 2.0,
      "MinOpenInterest": 100000
    },
    "Exit": {
      "PartialBookAtProfitPct": 15,
      "PartialBookFraction": 0.5,
      "StopLossPct": 10,
      "TrailAfterPartialBook": true,
      "ExitOnScoreFlip": true,
      "ExitOnScoreBelowAbs": 30,
      "MaxHoldMinutes": 120
    },
    "Costs": { "BrokeragePerOrder": 20, "SlippageTicks": 2 },
    "RiskLimits": { "MaxDailyLossPct": 20.0, "MaxDailyProfitPct": 30.0, "MaxConsecutiveLosses": 4 },
    "KillSwitch": { "EntriesEnabled": true }
  },
  "CoreScoreHysteresis": {
    "EntryScoreThreshold": 30.0,
    "RiskLimits": { "MaxDailyLossPct": 20.0, "MaxConsecutiveLosses": 4, "MaxTradesPerDay": 30 },
    "ShadowMode": false
  },
  "CoreScoreCrossover": {
    "FastWindowMinutes": 15,
    "SlowWindowMinutes": 30,
    "RiskLimits": { "MaxDailyLossPct": 20.0, "MaxConsecutiveLosses": 4, "MaxTradesPerDay": 30 },
    "ShadowMode": false
  },
  "ScoreWeights": {
    "Version": "live-2026-09-09",
    "OiBuildupNet": 0.3125,
    "Pcr": 0.19,
    "FuturesBasis": 0.1425,
    "IvSkew": 0.1425,
    "PriceMomentum": 0.0,
    "DepthImbalance": 0.1625,
    "VixChange": 0.05,
    "GammaExposure": 0.0,
    "VolumePcr": 0.0,
    "SpreadRatio": 0.0,
    "VannaExposure": 0.0,
    "CharmExposure": 0.0,
    "CvdProxy": 0.0,
    "StraddleRichness": 0.0
  },
  "Telegram": {
    "BotToken": "",
    "ChatId": ""
  },
  "MarketData": { "Provider": "FlatTrade" },
  "Upstox": { "ApiKey": "", "ApiSecret": "", "RedirectUri": "" },
  "FlatTrade": {
    "UserId": "",
    "ApiKey": "",
    "ApiSecret": ""
  }
}
