<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Builds the volume-cadence backtest dataset (2026-09-17 plan: "participant behaviour,
         not clock time, should set the pace") from raw historical future ticks into a brand-new,
         dedicated database, kept fully isolated from NiftySignal.Persistence's live schema and
         from NiftySignal.BacktestData's own time-cadence dataset. Mirrors
         NiftySignal.BacktestData's own project shape exactly. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2026-09-22, Part B: lets NiftySignal.Tests exercise TradeSimulator's pure single-side
         formula helpers (ComputeSideTobDivergence/ComputeCallScore/ComputePutScore, now internal
         rather than private) directly, without a DB fixture, same "new behavior gets a test" rule
         as everywhere else in this project, without changing these helpers' real visibility to
         any other caller (still inaccessible outside this project plus its test assembly). -->
    <InternalsVisibleTo Include="NiftySignal.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence, read-only here: the source of historical ticks/instruments
         (niftysignal_vm_copy). This project never writes to NiftySignalDbContext's tables. -->
    <ProjectReference Include="..\NiftySignal.Domain\NiftySignal.Domain.csproj" />
    <ProjectReference Include="..\NiftySignal.Persistence\NiftySignal.Persistence.csproj" />
    <ProjectReference Include="..\NiftySignal.Features\NiftySignal.Features.csproj" />
    <!-- 2026-09-18, options phase: ImpliedVolatilitySolver/BlackScholes/SyntheticForward/
         TimeToExpiry, the same already-validated pricing machinery CadencePopulator's own
         CONFIRMED IV skew metric uses, reused here rather than reimplemented. -->
    <ProjectReference Include="..\NiftySignal.Pricing\NiftySignal.Pricing.csproj" />
    <!-- Read-only here too: BacktestAnalysisDbContext (niftysignal_backtest_analysis, the
         existing time-cadence dataset) is the parity/sanity-check reference the "analyze" mode
         compares this project's own volume-bar numbers against. See AnalyzeCommand.cs. -->
    <ProjectReference Include="..\NiftySignal.BacktestData\NiftySignal.BacktestData.csproj" />
    <!-- 2026-09-20, live/backtest parity plan step 1: the locked OptionsScoreThreeWaySwitchMaxPainConfirmed
         scoring logic (ComputeOptionsThreeWayScore + PassesConfirmation's Max Pain branch) now lives
         in this dependency-free, pure-function project instead of a duplicated inline copy here.
         See docs/LIVE_PARITY_PLAN.md. -->
    <ProjectReference Include="..\NiftySignal.Scoring\NiftySignal.Scoring.csproj" />
    <!-- 2026-09-22, Experiment 5 (tradeability of activity/efficiency mean reversion): reuses the
         real, existing CostsConfig/PaperTradeSimulator cost model (RulesetConfig.cs's Costs section,
         live values in NiftySignal.Host/appsettings.json) for the cost-sensitivity pass rather than
         inventing a parallel cost formula. See docs/VOLUME_BAR_FINDINGS.md's Experiment 5 section. -->
    <ProjectReference Include="..\NiftySignal.Rules\NiftySignal.Rules.csproj" />
    <ProjectReference Include="..\NiftySignal.Execution\NiftySignal.Execution.csproj" />
  </ItemGroup>

</Project>
