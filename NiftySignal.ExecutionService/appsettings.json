{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/niftysignal-execution-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "NiftySignalDb": "",
    "TradingPaperLive": ""
  },
  "Execution": {
    "Enabled": false,
    "StrategyDirectory": "paper-engine-v2-strategies/execution-service",
    "CostScheduleVersion": "npt1-frozen-fees-v1",
    "BrokeragePerOrder": 0,
    "EntryCutoff": "15:00",
    "LiquidationStart": "15:08",
    "LiquidationDeadline": "15:10",
    "UnresolvedAfter": "15:25",
    "MaxProcessingLagSeconds": 5,
    "FramesToClearGap": 3,
    "ObserverHeartbeatStaleSeconds": 30,
    "FlattenGraceSeconds": 0,
    "FlattenWhenNotLiveAfterSeconds": 0,
    "MarketDataStaleSeconds": 10,
    "ExitStuckAfterSeconds": 10,
    "PollIntervalMilliseconds": 250,
    "LiveMarksEnabled": true,
    "Alerts": { "Opened": false, "Closed": false, "OrderRejected": false, "PartialFill": false, "ExecutionFailure": false }
  },
  "Telegram": {
    "BotToken": "",
    "ChatId": ""
  }
}
