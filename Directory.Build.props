<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SourceBranch Condition="'$(SourceBranch)' == ''">unknown</SourceBranch>
    <CommitSha Condition="'$(CommitSha)' == ''">unknown</CommitSha>
    <BuildUtc Condition="'$(BuildUtc)' == ''">$([System.DateTime]::UtcNow.ToString("O"))</BuildUtc>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- A nullable-reference-type warning is a real bug waiting to happen in this codebase
         (null IV on non-convergence, degraded feature windows, missing depth), never just a warning. -->
    <WarningsAsErrors>Nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SourceBranch</_Parameter1>
      <_Parameter2>$(SourceBranch)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CommitSha</_Parameter1>
      <_Parameter2>$(CommitSha)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildUtc</_Parameter1>
      <_Parameter2>$(BuildUtc)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
