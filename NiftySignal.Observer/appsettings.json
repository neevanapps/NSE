{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/niftysignal-observer-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "NiftySignalDb": ""
  },
  "Adaptive": {
    "Observer": { "Process": "Separate" },
    "Top5Microstructure": { "Enabled": false, "OptionsEnabled": false },
    "Recovery": { "TimeLimitSeconds": 300, "TimeoutRetryBackoffSeconds": 30, "ReadWindowSeconds": 120, "CheckpointsEnabled": true, "CheckpointIntervalSeconds": 60, "CheckpointRetention": 3 }
  },
  "Pricing": {
    "RiskFreeRate": 0.065
  }
}
